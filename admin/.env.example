# Copy to .env (gitignored) before `soli serve`.
#
# The admin talks to SoliDB over HTTP, often on localhost:6745. Soli's
# HTTP client blocks loopback/private IPs unless one of these is set.

SOLI_DEV_ALLOW_SSRF=1
SOLI_HTTP_ALLOW_HOSTS=localhost,127.0.0.1,[::1]

# Public hostname(s) this app is served under, comma-separated. Required as
# soon as a reverse proxy is in front: the proxy terminates the public name and
# forwards to a loopback port, so the browser's Origin never equals the
# authority the app sees and the CSRF check rejects every state-changing
# request while ordinary browsing keeps working.
#
# Do not reach for X-Forwarded-Host instead — apps bind 0.0.0.0, so anyone who
# can reach the port directly forges that header alongside a matching Origin
# and the same-origin check passes for every request. The allowlist comes from
# the deployment, not the request. See src/serve/csrf.rs in the framework.
# SOLI_APP_HOSTS=db.example.com,www.db.example.com

# How visitors of THIS app are authenticated. Required: the console signs in to
# SoliDB as an administrator and acts under that identity for whoever is
# browsing, so an unauthenticated port here is an unauthenticated database.
# Set exactly one; with neither, the app answers 503 and explains.
#
# ADMIN_UI_PASSWORD=$(openssl rand -hex 24)
# ADMIN_UI_ALLOW_NO_AUTH=1   # only if something in front really does authenticate
