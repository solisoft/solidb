<%# Always visible in the header: server-level pages fall back to _system so
    the active db (and the switcher) is never out of reach. %>
<% active_db = picker_db.blank? ? "_system" : picker_db %>
<% if picker_databases.length() > 0 %>
  <div x-data="dbPicker()" class="relative">
    <button @click="toggle()"
            @click.outside="open = false"
            class="btn-ghost">
      <span class="text-zinc-600">db:</span>
      <span class="text-teal-400"><%= active_db %></span>
      <span class="text-zinc-600">▾</span>
    </button>
    <div x-show="open" x-cloak x-transition.opacity.duration.120ms
         x-on:keydown.escape.stop="open = false"
         class="absolute right-0 z-20 mt-1 w-56 border border-zinc-700 bg-zinc-900 shadow-xl shadow-black/50">
      <div class="border-b border-zinc-800 p-2">
        <%# ArrowUp/Down move the highlight over filtered options, Enter follows
            the highlighted one - see public/js/admin-db-picker.js. %>
        <input type="text" x-ref="dbFilter" x-model="q" placeholder="filter…"
               @input="hi = 0; refresh()"
               @keydown.down.prevent="move(1)"
               @keydown.up.prevent="move(-1)"
               @keydown.enter.prevent="choose()"
               class="console-input py-1 font-mono text-xs" autocomplete="off">
      </div>
      <div class="max-h-72 overflow-y-auto" x-ref="dbList">
        <% for db_name in picker_databases %>
          <a href="<%= attr(db_collections_path(db_name)) %>"
             data-db="<%= attr(db_name) %>"
             x-show="q === '' || $el.dataset.db.toLowerCase().includes(q.toLowerCase())"
             class="block px-3 py-1.5 font-mono text-xs transition-colors <%= db_name == active_db ? "bg-zinc-800 text-teal-300" : "text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200" %>">
            <%= db_name %>
          </a>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
