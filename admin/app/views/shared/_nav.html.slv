<aside class="flex w-56 shrink-0 flex-col border-r border-zinc-800 bg-zinc-950">
  <a href="<%= root_path() %>" class="flex h-14 items-center gap-2.5 border-b border-zinc-800 px-5">
    <span class="relative flex h-2.5 w-2.5">
      <span class="absolute inline-flex h-full w-full animate-pulse-dot bg-teal-400"></span>
    </span>
    <span class="font-mono text-sm font-semibold tracking-widest text-zinc-100">SOLIDB</span>
    <span class="console-label mt-0.5">admin</span>
  </a>

  <nav class="flex-1 overflow-y-auto py-4">
    <p class="console-label px-5 pb-2">Server</p>
    <%# Each entry is [label, path, heroicon outline path data]. Multiple
        subpaths are merged into one d attribute (valid SVG). %>
    <% server_links = [
      ["Dashboard", root_path(),
       "M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"],
      ["Databases", databases_path(),
       "M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"],
      ["Users", users_path(),
       "M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"],
      ["Roles", roles_path(),
       "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"],
      ["API Keys", api_keys_path(),
       "M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"]
    ] %>
    <% for link in server_links %>
      <% is_active = nav_path == link[1] %>
      <a href="<%= attr(link[1]) %>"
         class="flex items-center gap-2.5 border-l-2 px-5 py-1.5 text-sm transition-colors <%= is_active ? "border-teal-400 bg-zinc-900 text-teal-300" : "border-transparent text-zinc-400 hover:border-zinc-700 hover:text-zinc-200" %>">
        <svg class="h-4 w-4 shrink-0 <%= is_active ? "text-teal-400" : "text-zinc-500" %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= attr(link[2]) %>" />
        </svg>
        <%= link[0] %>
      </a>
    <% end %>

    <% if !nav_db.blank? %>
      <p class="console-label mt-6 px-5 pb-2">db / <span class="text-teal-500"><%= nav_db %></span></p>
      <% db_links = [
        ["Collections", db_collections_path(nav_db),
         "M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0121 12v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6c0-.98.626-1.813 1.5-2.122"],
        ["Views", db_views_path(nav_db),
         "M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178zM15 12a3 3 0 11-6 0 3 3 0 016 0z"],
        ["Query", db_query_path(nav_db),
         "M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"],
        ["Scripts", db_scripts_path(nav_db),
         "M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"],
        ["Queues", db_queues_path(nav_db),
         "M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"],
        ["Cron", db_cron_path(nav_db),
         "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"],
        ["Triggers", db_triggers_path(nav_db),
         "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"],
        ["Env", db_env_path(nav_db),
         "M4.745 3A23.933 23.933 0 003 12c0 3.183.62 6.22 1.745 9M19.5 3c.967 2.78 1.5 5.817 1.5 9s-.533 6.22-1.5 9M8.25 8.885l1.444-.89a.75.75 0 011.105.402l2.402 7.206a.75.75 0 001.104.401l1.445-.889m-8.25.75l.213.09a1.687 1.687 0 002.062-.617l4.45-6.676a1.688 1.688 0 012.062-.618l.213.09"],
        ["Live", db_live_path(nav_db),
         "M9.348 14.652a3.75 3.75 0 010-5.304m5.304 0a3.75 3.75 0 010 5.304m-7.425 2.121a6.75 6.75 0 010-9.546m9.546 0a6.75 6.75 0 010 9.546M5.106 18.894c-3.808-3.807-3.808-9.98 0-13.788m13.788 0c3.808 3.807 3.808 9.98 0 13.788M12 12h.008v.008H12V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"]
      ] %>
      <% for link in db_links %>
        <% is_active = nav_path == link[1] %>
        <a href="<%= attr(link[1]) %>"
           class="flex items-center gap-2.5 border-l-2 px-5 py-1.5 text-sm transition-colors <%= is_active ? "border-teal-400 bg-zinc-900 text-teal-300" : "border-transparent text-zinc-400 hover:border-zinc-700 hover:text-zinc-200" %>">
          <svg class="h-4 w-4 shrink-0 <%= is_active ? "text-teal-400" : "text-zinc-500" %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= attr(link[2]) %>" />
          </svg>
          <%= link[0] %>
          <% if link[0] == "Query" %>
            <%# Slow query count, loaded async so page renders never wait on it. %>
            <span class="ml-auto" hx-get="<%= attr(db_query_path(nav_db)) %>/slow/count"
                  hx-trigger="load" hx-swap="innerHTML"></span>
          <% end %>
        </a>
      <% end %>
    <% end %>
  </nav>

  <div class="border-t border-zinc-800 px-5 py-3">
    <p class="console-label">SoliDB Admin</p>
  </div>
</aside>
