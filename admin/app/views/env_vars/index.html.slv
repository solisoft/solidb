<%- partial("shared/banners", { "solidb_down": @solidb_down, "flash_error": @flash_error, "flash_notice": @flash_notice }) %>

<div class="space-y-5 animate-fade-up" x-data="{ editing: false, envKey: '', envValue: '' }"
     x-on:keydown.escape.window="editing = false"
     x-effect="document.body.style.overflow = editing ? 'hidden' : ''">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="console-label">db / <%= @db %></p>
      <h2 class="mt-1">Env vars <span class="font-mono text-sm text-zinc-500">(<%= @env_vars.length() %>)</span></h2>
      <p class="mt-1 max-w-2xl font-mono text-xs text-zinc-600">
        per-database key/value settings readable from Lua scripts — use them for API keys and endpoints
        instead of hardcoding values in script source
      </p>
    </div>
    <button class="btn-primary" x-on:click="envKey = ''; envValue = ''; editing = true">New env var</button>
  </div>

  <%# Teleported to <body>: an ancestor with a retained transform/backdrop-filter
      acts as containing block for position:fixed and crops the modal to the
      content area. htmx.process() is required because htmx never initializes
      <template> content. %>
  <template x-teleport="body">
  <div x-show="editing" x-cloak x-init="htmx.process($el)"
       class="fixed inset-0 z-40 flex items-start justify-center overflow-y-auto overscroll-contain p-4 pt-16">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" x-on:click="editing = false"></div>
    <%# Submit swaps #content out and destroys this Alpine scope -- close first
        so the body scroll-lock is released before the swap. %>
    <form class="relative w-full max-w-xl border border-zinc-700 bg-zinc-900 shadow-2xl shadow-black/60 animate-fade-up"
          x-on:submit="editing = false"
          hx-post="<%= attr(db_env_path(@db)) %>" hx-target="#content" hx-swap="innerHTML show:top">
      <div class="flex items-center justify-between border-b border-zinc-800 px-5 py-3">
        <p class="console-label">set env var · <span class="text-teal-500"><%= @db %></span></p>
        <button type="button" class="font-mono text-zinc-600 transition-colors hover:text-zinc-300"
                x-on:click="editing = false">×</button>
      </div>
      <div class="space-y-3 px-5 py-4">
        <div>
          <label class="console-label" for="env-key">key</label>
          <input id="env-key" name="env_key" type="text" placeholder="STRIPE_API_KEY" x-model="envKey"
                 class="console-input mt-1 font-mono" autocomplete="off">
        </div>
        <div>
          <label class="console-label" for="env-value">value</label>
          <textarea id="env-value" name="env_value" rows="3" spellcheck="false" x-model="envValue"
                    class="console-input mt-1 resize-y font-mono text-[13px]"></textarea>
          <p class="mt-1 font-mono text-[10px] text-zinc-600">saving an existing key overwrites its value</p>
        </div>
      </div>
      <div class="flex justify-end gap-2 border-t border-zinc-800 px-5 py-3">
        <button type="button" class="btn-ghost" x-on:click="editing = false">Cancel</button>
        <button type="submit" class="btn-primary">Save env var</button>
      </div>
    </form>
  </div>
  </template>

  <div class="console-card">
    <table class="console-table">
      <thead>
        <tr>
          <th>key</th>
          <th>value</th>
          <th class="text-right">actions</th>
        </tr>
      </thead>
      <tbody>
        <% for row in @env_vars %>
          <tr>
            <td class="font-mono text-zinc-200"><%= row["key"] %></td>
            <td class="max-w-md">
              <code class="block truncate font-mono text-xs text-zinc-400" title="<%= attr(row["value"]) %>"><%= row["value"] %></code>
            </td>
            <td class="w-px whitespace-nowrap text-right">
              <div class="flex justify-end gap-2">
                <button class="btn-ghost"
                        data-key="<%= attr(row["key"]) %>" data-value="<%= attr(row["value"]) %>"
                        x-on:click="envKey = $el.dataset.key; envValue = $el.dataset.value; editing = true">
                  Edit
                </button>
                <button class="btn-danger"
                        hx-delete="<%= attr(db_env_path(@db)) %>/<%= url(row["key"]) %>"
                        hx-target="#content" hx-swap="innerHTML show:top"
                        hx-confirm="Delete env var '<%= attr(row["key"]) %>'?">
                  Delete
                </button>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @env_vars.length() == 0 %>
      <p class="px-4 py-8 text-center font-mono text-sm text-zinc-600">no env vars in <%= @db %></p>
    <% end %>
  </div>
</div>
