<% if !jobs_error.blank? %>
  <div class="border-t border-zinc-800 bg-red-950/30 px-4 py-2 font-mono text-xs text-red-300">
    <%= jobs_error %>
  </div>
<% else %>
  <% jobs_base = db_queues_path(db) + "/" + url(queue_name) + "/jobs" %>
  <% jobs_target = "#jobs-" + queue_name %>
  <%# Preserve status + limit across pagination clicks. %>
  <% page_query = "?limit=" + str(jobs_limit) %>
  <% page_query = page_query + "&status=" + url(status_filter) unless status_filter.blank? %>
  <%# q drives the client-side text search over the rows on this page; the
      status pills + pagination below page on the server. %>
  <div class="border-t border-zinc-800 animate-fade-up" x-data="{ q: '' }">
    <%# Filter bar: free-text search, status pills (each resets offset to 0),
        and a per-page selector. %>
    <div class="space-y-2 border-b border-zinc-800 px-4 py-2.5">
      <input type="search" x-model="q" autocomplete="off" spellcheck="false"
             placeholder="search this page — script, webhook, or job id…"
             class="console-input w-full font-mono text-xs">
      <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-1.5">
        <% for status_option in ["", "pending", "running", "completed", "failed"] %>
          <% pill_query = jobs_base + "?limit=" + str(jobs_limit) %>
          <% pill_query = pill_query + "&status=" + url(status_option) unless status_option.blank? %>
          <% pill_active = status_filter == status_option %>
          <button class="border px-2 py-0.5 font-mono text-[10px] <%= pill_active ? "border-teal-700 text-teal-300" : "border-zinc-800 text-zinc-500 hover:text-zinc-300" %>"
                  hx-get="<%- attr(pill_query) %>"
                  hx-target="<%- attr(jobs_target) %>" hx-swap="innerHTML">
            <%= status_option.blank? ? "all" : status_option %>
          </button>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
        <span class="console-label">per page</span>
        <% for limit_option in [25, 50, 100] %>
          <% limit_query = jobs_base + "?limit=" + str(limit_option) %>
          <% limit_query = limit_query + "&status=" + url(status_filter) unless status_filter.blank? %>
          <button class="border px-2 py-0.5 font-mono text-[10px] <%= jobs_limit == limit_option ? "border-teal-700 text-teal-300" : "border-zinc-800 text-zinc-500 hover:text-zinc-300" %>"
                  hx-get="<%- attr(limit_query) %>"
                  hx-target="<%- attr(jobs_target) %>" hx-swap="innerHTML">
            <%= limit_option %>
          </button>
        <% end %>
      </div>
      </div>
    </div>
    <% if jobs.length() == 0 %>
      <p class="px-4 py-4 text-center font-mono text-xs text-zinc-600">
        <% if status_filter.blank? %>
          no jobs in <%= queue_name %>
        <% else %>
          no <%= status_filter %> jobs in <%= queue_name %>
        <% end %>
      </p>
    <% else %>
      <div class="overflow-x-auto"><table class="console-table">
        <thead>
          <tr>
            <th>script/webhook</th>
            <th>status</th>
            <th class="text-right">priority</th>
            <th class="text-right">actions</th>
          </tr>
        </thead>
        <tbody x-data="{ open: null }">
          <% for job, i in jobs %>
            <% job_id = job["_key"] ?? "" %>
            <% job_status = job["status"] ?? "pending" %>
            <%# Lowercased haystack for the client-side search box (data-search). %>
            <% job_target = job["script_path"] ?? (job["script"] ?? "") %>
            <% job_target = job["webhook_url"] ?? (job["callback_url"] ?? "") if job_target.blank? %>
            <% job_search = (job_target + " " + job_id + " " + job_status).downcase() %>
            <%# Whole row toggles the details panel; the actions cell stops
                propagation so Run now / Cancel do not also toggle. %>
            <tr class="cursor-pointer" data-search="<%= attr(job_search) %>"
                x-show="q === '' || $el.dataset.search.includes(q.toLowerCase())"
                x-on:click="open = open === <%= i %> ? null : <%= i %>">
              <% job_webhook = job["webhook_url"] ?? (job["callback_url"] ?? "") %>
              <td class="font-mono text-xs text-zinc-200">
                <span class="mr-1 inline-block text-zinc-600 transition-transform"
                      x-bind:class="open === <%= i %> ? 'rotate-90' : ''">&rsaquo;</span>
                <% if job_webhook.blank? %>
                  <%= job["script_path"] ?? (job["script"] ?? "") %>
                <% else %>
                  <span class="break-all">
                    <span class="text-zinc-600">webhook:</span> <%= job_webhook %>
                  </span>
                <% end %>
                <p class="mt-0.5 break-all text-[10px] text-zinc-600"><%= job_id %></p>
              </td>
              <td>
                <span class="border px-1.5 py-0.5 font-mono text-[10px] <%= job_status == "failed" ? "border-red-900 text-red-400" : (job_status == "running" ? "border-teal-900 text-teal-400" : "border-zinc-800 text-zinc-400") %>">
                  <%= job_status %>
                </span>
              </td>
              <td class="text-right font-mono text-xs text-zinc-400"><%= job["priority"] ?? 0 %></td>
              <td class="w-px whitespace-nowrap text-right" x-on:click.stop>
                <div class="flex justify-end gap-2">
                  <button class="btn-ghost"
                          hx-post="<%= attr(db_queues_path(db)) %>/jobs/<%= url(job_id) %>/run-now"
                          hx-target="#content" hx-swap="innerHTML show:top">
                    Run now
                  </button>
                  <button class="btn-danger"
                          hx-delete="<%= attr(db_queues_path(db)) %>/jobs/<%= url(job_id) %>"
                          hx-target="#content" hx-swap="innerHTML show:top"
                          hx-confirm="Cancel job <%= attr(job_id) %>?">
                    Cancel
                  </button>
                </div>
              </td>
            </tr>
            <tr data-search="<%= attr(job_search) %>" x-cloak
                x-show="open === <%= i %> && (q === '' || $el.dataset.search.includes(q.toLowerCase()))">
              <td colspan="4" class="bg-zinc-950/60 px-4 py-3">
                <div class="grid grid-cols-2 gap-x-8 gap-y-2 sm:grid-cols-3 lg:grid-cols-4">
                  <div class="col-span-2 sm:col-span-3 lg:col-span-4">
                    <p class="console-label">job id</p>
                    <p class="break-all font-mono text-xs text-zinc-300"><%= job_id %></p>
                  </div>
                  <div>
                    <p class="console-label">created</p>
                    <p class="font-mono text-xs text-zinc-300"><%= fmt_epoch(job["created_at"]) %></p>
                  </div>
                  <div>
                    <p class="console-label">run at</p>
                    <p class="font-mono text-xs text-zinc-300"><%= fmt_epoch(job["run_at"]) %></p>
                  </div>
                  <div>
                    <p class="console-label">started</p>
                    <p class="font-mono text-xs text-zinc-300"><%= fmt_epoch_ms(job["started_at"]) %></p>
                  </div>
                  <div>
                    <p class="console-label">completed</p>
                    <p class="font-mono text-xs text-zinc-300"><%= fmt_epoch_ms(job["completed_at"]) %></p>
                  </div>
                  <div>
                    <p class="console-label">duration</p>
                    <% job_started = job["started_at"] %>
                    <% job_completed = job["completed_at"] %>
                    <p class="font-mono text-xs text-zinc-300"><%= (job_started.nil? || job_completed.nil?) ? "-" : fmt_ms(job_completed - job_started) %></p>
                  </div>
                  <div>
                    <p class="console-label">retries</p>
                    <p class="font-mono text-xs text-zinc-300"><%= str(job["retry_count"] ?? 0) + " / " + str(job["max_retries"] ?? 0) %></p>
                  </div>
                  <% job_cron = job["cron_job_id"] ?? "" %>
                  <% if !job_cron.blank? %>
                    <div>
                      <p class="console-label">cron job</p>
                      <p class="break-all font-mono text-xs text-zinc-300"><%= job_cron %></p>
                    </div>
                  <% end %>
                </div>
                <% job_params_json = json_compact(job["params"]) %>
                <% if !job_params_json.blank? && job_params_json != "null" %>
                  <div class="mt-3">
                    <p class="console-label">params</p>
                    <pre class="mt-1 whitespace-pre-wrap break-all border border-zinc-800 bg-zinc-900/60 px-3 py-2 font-mono text-xs text-zinc-300"><%= job_params_json %></pre>
                  </div>
                <% end %>
                <% job_error = job["last_error"] ?? "" %>
                <% if !job_error.blank? %>
                  <div class="mt-3">
                    <p class="console-label">last error</p>
                    <pre class="mt-1 whitespace-pre-wrap break-all border border-red-900 bg-red-950/30 px-3 py-2 font-mono text-xs text-red-300"><%= job_error %></pre>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
      <%# Pagination footer: range + prev/next paged on the API's filtered total. %>
      <% jobs_from = jobs_offset + 1 %>
      <% jobs_to = jobs_offset + jobs.length() %>
      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-zinc-800 px-4 py-2.5">
        <p class="console-label">
          jobs <%= jobs_from %>&ndash;<%= jobs_to %> of <%= jobs_total %>
          <span class="text-zinc-600">&middot; newest first</span>
        </p>
        <div class="flex gap-2">
          <% if jobs_offset > 0 %>
            <% prev_offset = jobs_offset - jobs_limit %>
            <% prev_offset = 0 if prev_offset < 0 %>
            <button class="btn-ghost"
                    hx-get="<%- attr(jobs_base + page_query) %>&offset=<%= prev_offset %>"
                    hx-target="<%- attr(jobs_target) %>" hx-swap="innerHTML">&larr; Prev</button>
          <% end %>
          <% if jobs_offset + jobs_limit < jobs_total %>
            <button class="btn-ghost"
                    hx-get="<%- attr(jobs_base + page_query) %>&offset=<%= jobs_offset + jobs_limit %>"
                    hx-target="<%- attr(jobs_target) %>" hx-swap="innerHTML">Next &rarr;</button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
