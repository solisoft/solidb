<% if !query_error.blank? %>
  <div class="console-card border-red-900 px-4 py-3 animate-fade-up">
    <p class="console-label text-red-400">query error</p>
    <pre class="mt-2 overflow-x-auto font-mono text-xs text-red-200"><%= query_error %></pre>
  </div>
<% else %>
  <div class="console-card animate-fade-up">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1 border-b border-zinc-800 px-4 py-2.5">
      <p class="console-label"><span class="text-teal-400"><%= rows.length() %></span> rows</p>
      <%# normal-case: console-label is uppercase, which turns "µs" into the
          Greek capital "ΜS" — unreadable as anything but "MS". %>
      <p class="console-label"><span class="normal-case text-teal-400"><%= fmt_ms(meta["executionTimeMs"] ?? 0) %></span></p>
      <% if (meta["inserted"] ?? 0) > 0 %><p class="console-label"><span class="text-teal-400"><%= meta["inserted"] %></span> inserted</p><% end %>
      <% if (meta["updated"] ?? 0) > 0 %><p class="console-label"><span class="text-teal-400"><%= meta["updated"] %></span> updated</p><% end %>
      <% if (meta["deleted"] ?? 0) > 0 %><p class="console-label"><span class="text-teal-400"><%= meta["deleted"] %></span> deleted</p><% end %>
      <% if meta["has_more"] %><p class="console-label text-amber-400">truncated at batch size</p><% end %>
    </div>
    <% if rows.length() == 0 %>
      <p class="px-4 py-6 text-center font-mono text-sm text-zinc-600">empty result</p>
    <% else %>
      <ol class="max-h-[32rem] divide-y divide-zinc-800/60 overflow-y-auto">
        <% for row, row_index in rows %>
          <li>
            <details class="group">
              <summary class="flex cursor-pointer gap-3 px-4 py-2 transition-colors hover:bg-zinc-900/80">
                <span class="select-none font-mono text-xs text-zinc-600 transition-colors group-open:text-teal-400"><%= row_index %></span>
                <code class="min-w-0 flex-1 truncate font-mono text-xs leading-relaxed text-zinc-300"><%= json_compact(row) %></code>
              </summary>
              <pre class="json-view overflow-x-auto border-t border-zinc-800/40 bg-zinc-950/70 px-10 py-3 font-mono text-xs leading-relaxed"><%= json_compact(row) %></pre>
            </details>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>
<% end %>
