<%# Saved connections live in localStorage (per-browser, like the query
    history). The component is defined in the inline script below - it runs
    during HTML parse, before the deferred alpine.min.js boots. %>
<div class="mx-auto max-w-2xl space-y-5 animate-fade-up" x-data="connectionPage()">
  <div>
    <p class="console-label">server</p>
    <h2 class="mt-1">Connection</h2>
    <p class="mt-1 max-w-2xl console-help">
      point this browser session at any SoliDB server — credentials are checked with a real login
      before being stored (server-side session)
    </p>
  </div>

  <div class="console-card px-4 py-3">
    <p class="console-label">currently connected to</p>
    <div class="mt-1.5 flex flex-wrap items-center gap-3">
      <span class="font-mono text-sm text-teal-300"><%= @current_host %></span>
      <span class="font-mono text-xs text-zinc-500">as <%= @current_username %></span>
      <% if @overridden %>
        <span class="console-label border border-teal-900 px-1.5 py-0.5 text-teal-400">session override</span>
      <% else %>
        <span class="console-label border border-zinc-800 px-1.5 py-0.5">env defaults</span>
      <% end %>
    </div>
    <% if @overridden %>
      <form method="post" action="<%= attr(connection_path()) %>/reset" class="mt-3">
        <button type="submit" class="btn-ghost">Reset to environment defaults (<%= @env_host %>)</button>
      </form>
    <% end %>
  </div>

  <% if !@connection_error.blank? %>
    <div class="console-card border-red-900 px-4 py-3">
      <p class="console-label text-red-400">connection failed</p>
      <p class="mt-1 font-mono text-xs text-red-200"><%= @connection_error %></p>
    </div>
  <% end %>

  <div class="console-card" x-show="saved.length > 0" x-cloak>
    <div class="border-b border-zinc-800 px-4 py-2.5">
      <p class="console-label">saved connections <span class="text-zinc-700">— this browser</span></p>
    </div>
    <ul class="divide-y divide-zinc-800/60">
      <template x-for="(entry, index) in saved" :key="entry.host + '|' + entry.username">
        <li class="flex items-center gap-3 px-4 py-2">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-600"></span>
          <button type="button" x-on:click="connect(entry)"
                  class="min-w-0 flex-1 truncate text-left font-mono text-xs text-zinc-200 transition-colors hover:text-teal-300"
                  title="connect to this server">
            <span x-text="entry.host"></span>
            <span class="text-zinc-500" x-text="' as ' + entry.username"></span>
            <span class="text-zinc-600" x-show="!entry.password"> · no password saved</span>
          </button>
          <button type="button" class="btn-ghost" x-on:click="connect(entry)">Connect</button>
          <button type="button" class="btn-danger" x-on:click="remove(index)">Delete</button>
        </li>
      </template>
    </ul>
  </div>

  <form method="post" action="<%= attr(connection_path()) %>" class="console-card space-y-4 p-5"
        x-ref="form" x-on:submit="persist($refs.form)">
    <div>
      <label class="console-label" for="conn-host">server url</label>
      <input id="conn-host" name="host" type="text" autocomplete="off"
             placeholder="https://db.example.com or 192.168.1.30:6745"
             value="<%- attr(@form_host) %>"
             class="console-input mt-1 font-mono text-[13px]">
      <p class="mt-1 font-mono text-xs text-zinc-600">bare host:port gets http:// — use https:// for remote servers</p>
    </div>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div>
        <label class="console-label" for="conn-username">username</label>
        <input id="conn-username" name="username" type="text" autocomplete="username"
               value="<%- attr(@form_username) %>"
               class="console-input mt-1 font-mono">
      </div>
      <div>
        <label class="console-label" for="conn-password">password</label>
        <input id="conn-password" name="password" type="password" autocomplete="current-password"
               class="console-input mt-1 font-mono">
      </div>
    </div>
    <div class="space-y-1.5">
      <label class="flex items-center gap-2 font-mono text-xs text-zinc-400">
        <input type="checkbox" x-model="saveConnection" class="accent-teal-500">
        save this connection in this browser
      </label>
      <label class="flex items-center gap-2 font-mono text-xs text-zinc-400" x-show="saveConnection" x-cloak>
        <input type="checkbox" x-model="savePassword" class="accent-teal-500">
        also remember the password <span class="text-zinc-600">(plaintext in localStorage — skip it on shared machines)</span>
      </label>
    </div>
    <div class="flex items-center justify-between gap-2">
      <p class="font-mono text-xs text-zinc-600">the override lasts for this browser session</p>
      <button type="submit" class="btn-primary">Connect</button>
    </div>
  </form>
</div>

<script>
  // Defined before the deferred alpine.min.js evaluates, so the x-data
  // expression above resolves (same constraint as admin-db-picker.js).
  window.connectionPage = function () {
    var STORAGE_KEY = "solidb-admin:connections";
    return {
      saved: [],
      saveConnection: true,
      savePassword: false,
      init: function () {
        try { this.saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"); }
        catch (e) { this.saved = []; }
      },
      store: function () {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(this.saved));
      },
      // Called on form submit, before the POST navigates away. An unchecked
      // "remember password" box never ERASES a stored password (that wiped
      // saved passwords whenever a saved entry was re-used) - forgetting one
      // is an explicit Delete of the entry.
      persist: function (form) {
        if (!this.saveConnection) return;
        var host = form.host.value.trim();
        var username = form.username.value.trim();
        if (!host || !username) return;
        var previous = this.saved.find(function (saved_entry) {
          return saved_entry.host === host && saved_entry.username === username;
        });
        var password = this.savePassword ? form.password.value : (previous ? previous.password : "");
        this.saved = this.saved.filter(function (saved_entry) {
          return !(saved_entry.host === host && saved_entry.username === username);
        });
        this.saved.unshift({ host: host, username: username, password: password });
        this.saved = this.saved.slice(0, 10);
        this.store();
      },
      fill: function (entry) {
        var form = this.$refs.form;
        form.host.value = entry.host;
        form.username.value = entry.username;
        form.password.value = entry.password || "";
        // Mirror the entry so the persist-on-submit keeps what was saved.
        this.saveConnection = true;
        this.savePassword = !!entry.password;
        if (!entry.password) form.password.focus();
      },
      // One click when the password is saved; otherwise fill + focus password.
      connect: function (entry) {
        this.fill(entry);
        if (entry.password) this.$refs.form.requestSubmit();
      },
      remove: function (index) {
        this.saved.splice(index, 1);
        this.store();
      }
    };
  };
</script>
