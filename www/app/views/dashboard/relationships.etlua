<% local db = db %>

<div class="mb-5 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-text flex items-center gap-3">
      <i class="fas fa-sitemap text-accent-light"></i>
      Relationships
    </h1>
    <p class="text-text-muted text-sm mt-1">
      A map of every collection in <span class="font-medium text-text"><%= db %></span> and the relations
      inferred from their index keys. Drag nodes to rearrange &middot; scroll to zoom &middot; drag the canvas to pan.
    </p>
  </div>

  <!-- Summary stats -->
  <div id="rel-stats" class="flex items-center gap-3 text-sm">
    <div class="px-3 py-2 rounded-lg bg-bg-card/60 border border-border/50 flex items-center gap-2">
      <i class="fas fa-folder text-primary-light"></i>
      <span class="font-semibold text-text" data-stat="collections">–</span>
      <span class="text-text-muted">collections</span>
    </div>
    <div class="px-3 py-2 rounded-lg bg-bg-card/60 border border-border/50 flex items-center gap-2">
      <i class="fas fa-link text-accent-light"></i>
      <span class="font-semibold text-text" data-stat="relations">–</span>
      <span class="text-text-muted">relations</span>
    </div>
  </div>
</div>

<!-- Toolbar -->
<div class="flex flex-wrap items-center gap-2 mb-3">
  <div class="relative flex-1 min-w-[200px] max-w-xs">
    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-text-dim text-xs"></i>
    <input id="rel-search" type="text" placeholder="Find a collection…" autocomplete="off"
           class="w-full pl-9 pr-3 py-2 text-sm rounded-lg bg-bg-card/60 border border-border/50 text-text placeholder:text-text-dim focus:outline-none focus:border-primary/60 focus:ring-1 focus:ring-primary/40">
  </div>

  <select id="rel-layout"
          class="px-3 py-2 text-sm rounded-lg bg-bg-card/60 border border-border/50 text-text focus:outline-none focus:border-primary/60 cursor-pointer">
    <option value="cose">Layout: Force</option>
    <option value="concentric">Layout: Concentric</option>
    <option value="breadthfirst">Layout: Hierarchy</option>
    <option value="circle">Layout: Circle</option>
    <option value="grid">Layout: Grid</option>
  </select>

  <div class="flex items-center rounded-lg border border-border/50 bg-bg-card/60 overflow-hidden text-sm">
    <button id="toggle-fk" type="button" data-on="1"
            class="px-3 py-2 flex items-center gap-2 hover:bg-white/5 transition-colors border-r border-border/50">
      <span class="inline-block w-3 h-1 rounded" style="background:#818cf8"></span> Index keys
    </button>
    <button id="toggle-graph" type="button" data-on="1"
            class="px-3 py-2 flex items-center gap-2 hover:bg-white/5 transition-colors">
      <span class="inline-block w-3" style="border-top:2px dashed #34d399"></span> Edge refs
    </button>
  </div>

  <label class="flex items-center gap-2 px-3 py-2 text-sm rounded-lg bg-bg-card/60 border border-border/50 cursor-pointer hover:bg-white/5 transition-colors">
    <input id="toggle-system" type="checkbox" style="accent-color:#7c3aed">
    <span class="text-text-muted">System</span>
  </label>

  <div class="flex-1"></div>

  <button id="rel-relayout" type="button" title="Re-run layout"
          class="px-3 py-2 text-sm rounded-lg bg-bg-card/60 border border-border/50 text-text-muted hover:text-text hover:bg-white/5 transition-colors">
    <i class="fas fa-shuffle"></i>
  </button>
  <button id="rel-fit" type="button" title="Fit to screen"
          class="px-3 py-2 text-sm rounded-lg bg-bg-card/60 border border-border/50 text-text-muted hover:text-text hover:bg-white/5 transition-colors">
    <i class="fas fa-expand"></i>
  </button>
  <button id="rel-export" type="button" title="Export PNG"
          class="px-3 py-2 text-sm rounded-lg bg-bg-card/60 border border-border/50 text-text-muted hover:text-text hover:bg-white/5 transition-colors">
    <i class="fas fa-camera"></i>
  </button>
  <button id="rel-reload" type="button" title="Reload data"
          class="px-3 py-2 text-sm rounded-lg bg-primary/20 border border-primary/40 text-primary-light hover:bg-primary/30 transition-colors">
    <i class="fas fa-rotate"></i>
  </button>
</div>

<!-- Canvas + side panel -->
<div class="relative rounded-xl border border-border/50 bg-bg-dark/40 overflow-hidden" style="height: calc(100vh - 16rem); min-height: 480px;">
  <!-- Graph canvas (draggable / pannable) -->
  <div id="rel-canvas" class="absolute inset-0"></div>

  <!-- Loading overlay -->
  <div id="rel-loading" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-bg-dark/60 backdrop-blur-sm z-20">
    <i class="fas fa-circle-notch fa-spin text-3xl text-primary-light"></i>
    <span class="text-text-muted text-sm">Mapping collections &amp; index keys…</span>
  </div>

  <!-- Empty state -->
  <div id="rel-empty" class="absolute inset-0 hidden flex-col items-center justify-center gap-4 text-center px-6 z-10">
    <i class="fas fa-diagram-project text-4xl text-text-dim"></i>
    <p id="rel-empty-msg" class="text-text-muted text-sm max-w-sm">No collections found in this database.</p>
    <button id="rel-empty-system" type="button"
            class="hidden px-4 py-2 text-sm rounded-lg bg-primary/20 border border-primary/40 text-primary-light hover:bg-primary/30 transition-colors">
      <i class="fas fa-eye mr-1"></i> Show system collections
    </button>
    <a href="/database/_system/databases" class="text-xs text-text-dim hover:text-text-muted underline">
      Switch to another database
    </a>
  </div>

  <!-- Legend -->
  <div class="absolute bottom-3 left-3 z-10 px-3 py-2.5 rounded-lg bg-bg-card/80 backdrop-blur-md border border-border/50 text-xs space-y-2 pointer-events-none">
    <div class="flex items-center gap-2">
      <span class="inline-block w-3.5 h-3.5 rounded-full" style="background:#6366f1"></span>
      <span class="text-text-muted">Document collection</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block w-3.5 h-3.5 rounded-md" style="background:#f59e0b"></span>
      <span class="text-text-muted">Edge collection</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block w-4 h-1 rounded" style="background:#818cf8"></span>
      <span class="text-text-muted">Index-key relation</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block w-4" style="border-top:2px dashed #34d399"></span>
      <span class="text-text-muted">Edge _from/_to</span>
    </div>
  </div>

  <!-- Detail side panel -->
  <div id="rel-panel" class="absolute top-0 right-0 h-full w-80 max-w-[80%] bg-bg-card/95 backdrop-blur-xl border-l border-border/50 translate-x-full transition-transform duration-300 z-30 overflow-y-auto">
    <div class="p-4">
      <div class="flex items-start justify-between gap-2 mb-4">
        <div>
          <div id="panel-type" class="text-xs uppercase tracking-wider text-text-dim mb-1">Collection</div>
          <h3 id="panel-title" class="text-lg font-bold text-text break-all"></h3>
        </div>
        <button onclick="RelMap.closePanel()" class="p-1.5 rounded-lg text-text-muted hover:text-text hover:bg-white/10 transition-colors">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="grid grid-cols-3 gap-2 mb-4">
        <div class="px-2 py-2 rounded-lg bg-bg-dark/40 border border-border/40 text-center">
          <div id="panel-docs" class="text-sm font-bold text-text">0</div>
          <div class="text-[10px] uppercase tracking-wide text-text-dim">docs</div>
        </div>
        <div class="px-2 py-2 rounded-lg bg-bg-dark/40 border border-border/40 text-center">
          <div id="panel-indexes" class="text-sm font-bold text-text">0</div>
          <div class="text-[10px] uppercase tracking-wide text-text-dim">indexes</div>
        </div>
        <div class="px-2 py-2 rounded-lg bg-bg-dark/40 border border-border/40 text-center">
          <div id="panel-relations" class="text-sm font-bold text-text">0</div>
          <div class="text-[10px] uppercase tracking-wide text-text-dim">refs</div>
        </div>
      </div>

      <div class="mb-3">
        <h4 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-2">References out</h4>
        <div id="panel-out" class="space-y-1.5 text-sm"></div>
      </div>
      <div class="mb-4">
        <h4 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-2">Referenced by</h4>
        <div id="panel-in" class="space-y-1.5 text-sm"></div>
      </div>

      <div class="flex flex-col gap-2">
        <a id="panel-browse" href="#" class="w-full text-center px-3 py-2 text-sm rounded-lg bg-primary/20 border border-primary/40 text-primary-light hover:bg-primary/30 transition-colors">
          <i class="fas fa-table mr-1"></i> Browse documents
        </a>
        <a id="panel-idx" href="#" class="w-full text-center px-3 py-2 text-sm rounded-lg bg-bg-dark/40 border border-border/50 text-text-muted hover:text-text hover:bg-white/5 transition-colors">
          <i class="fas fa-key mr-1"></i> Manage indexes
        </a>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  "use strict";

  var DB = <%- EncodeJson(db) %>;
  var DATA_URL = "/database/" + encodeURIComponent(DB) + "/relationships/data";

  var COLORS = {
    document: "#6366f1",
    edge: "#f59e0b",
    fk: "#818cf8",
    graph: "#34d399",
    highlight: "#a78bfa"
  };

  var RelMap = {
    cy: null,
    raw: { nodes: [], edges: [] },

    init: function () {
      var self = this;
      var run = function () { self.load(); };
      if (typeof cytoscape !== "undefined") {
        run();
      } else {
        var tries = 0;
        var iv = setInterval(function () {
          if (typeof cytoscape !== "undefined") { clearInterval(iv); run(); }
          else if (++tries > 50) { clearInterval(iv); showToast("Graph library failed to load. Refresh the page.", "error"); }
        }, 100);
      }
      this.bindToolbar();
    },

    showLoading: function (on) {
      var el = document.getElementById("rel-loading");
      if (el) el.style.display = on ? "flex" : "none";
    },

    load: function () {
      var self = this;
      this.showLoading(true);
      var includeSystem = document.getElementById("toggle-system").checked;
      fetch(DATA_URL + "?include_system=" + (includeSystem ? "true" : "false"), {
        headers: { "Accept": "application/json" },
        credentials: "same-origin"
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          self.raw = data;
          self.render(data);
          self.updateStats(data.stats);
          self.showLoading(false);
        })
        .catch(function (err) {
          console.error(err);
          self.showLoading(false);
          showToast("Failed to load relationships", "error");
        });
    },

    updateStats: function (stats) {
      if (!stats) return;
      var c = document.querySelector('#rel-stats [data-stat="collections"]');
      var r = document.querySelector('#rel-stats [data-stat="relations"]');
      if (c) c.textContent = stats.collections;
      if (r) r.textContent = stats.relations;
    },

    render: function (data) {
      var nodes = data.nodes || [];
      var edges = data.edges || [];

      var empty = document.getElementById("rel-empty");
      if (!nodes.length) {
        if (empty) empty.style.display = "flex";
        // If system collections are hidden, the database may only hold internal
        // (_-prefixed) collections — offer a one-click way to reveal them.
        var sysToggle = document.getElementById("toggle-system");
        var sysBtn = document.getElementById("rel-empty-system");
        var msg = document.getElementById("rel-empty-msg");
        if (sysToggle && !sysToggle.checked) {
          if (sysBtn) sysBtn.classList.remove("hidden");
          if (msg) msg.textContent = "No user collections in " + DB + ". This database may only contain system collections.";
        } else {
          if (sysBtn) sysBtn.classList.add("hidden");
          if (msg) msg.textContent = "No collections found. Create collections and add index keys (like user_id) to see relations appear here.";
        }
        if (this.cy) { this.cy.destroy(); this.cy = null; }
        return;
      }
      if (empty) empty.style.display = "none";

      // Scale node size by how connected it is.
      var maxRel = 1;
      nodes.forEach(function (n) { maxRel = Math.max(maxRel, (n.relationCount || 0)); });

      var elements = [];
      nodes.forEach(function (n) {
        var size = 34 + Math.round(((n.relationCount || 0) / maxRel) * 30);
        elements.push({
          data: {
            id: n.id,
            label: n.label,
            ntype: n.type,
            count: n.count || 0,
            indexCount: n.indexCount || 0,
            relationCount: n.relationCount || 0,
            color: n.type === "edge" ? COLORS.edge : COLORS.document,
            size: size
          }
        });
      });
      edges.forEach(function (e) {
        elements.push({
          data: {
            id: e.id,
            source: e.source,
            target: e.target,
            label: e.label || "",
            kind: e.kind,
            unique: e.unique ? 1 : 0,
            color: e.kind === "graph" ? COLORS.graph : COLORS.fk
          }
        });
      });

      if (this.cy) { this.cy.destroy(); }

      this.cy = cytoscape({
        container: document.getElementById("rel-canvas"),
        elements: elements,
        wheelSensitivity: 0.3,
        minZoom: 0.15,
        maxZoom: 3,
        style: [
          {
            selector: "node",
            style: {
              "background-color": "data(color)",
              "label": "data(label)",
              "color": "#e2e8f0",
              "font-size": "11px",
              "font-weight": "600",
              "text-valign": "bottom",
              "text-halign": "center",
              "text-margin-y": 5,
              "width": "data(size)",
              "height": "data(size)",
              "text-outline-color": "#0f172a",
              "text-outline-width": 2.5,
              "text-max-width": "120px",
              "text-wrap": "ellipsis",
              "border-width": 2,
              "border-color": "#0f172a",
              "transition-property": "background-color, border-color, opacity",
              "transition-duration": "0.2s"
            }
          },
          {
            selector: 'node[ntype = "edge"]',
            style: { "shape": "round-rectangle" }
          },
          {
            selector: "node:selected",
            style: {
              "border-width": 4,
              "border-color": COLORS.highlight,
              "background-color": COLORS.highlight
            }
          },
          {
            selector: "node.faded",
            style: { "opacity": 0.12 }
          },
          {
            selector: "node.match",
            style: { "border-width": 4, "border-color": "#fbbf24" }
          },
          {
            selector: "edge",
            style: {
              "width": 2,
              "line-color": "data(color)",
              "target-arrow-color": "data(color)",
              "target-arrow-shape": "triangle",
              "arrow-scale": 1.1,
              "curve-style": "bezier",
              "label": "data(label)",
              "font-size": "9px",
              "color": "#94a3b8",
              "text-background-color": "#0f172a",
              "text-background-opacity": 0.85,
              "text-background-padding": "2px",
              "text-rotation": "autorotate",
              "transition-property": "opacity",
              "transition-duration": "0.2s"
            }
          },
          {
            selector: 'edge[kind = "graph"]',
            style: { "line-style": "dashed" }
          },
          {
            selector: 'edge[unique = 1]',
            style: { "width": 3 }
          },
          {
            selector: "edge.faded",
            style: { "opacity": 0.06 }
          },
          {
            selector: ".hidden",
            style: { "display": "none" }
          }
        ],
        layout: this.layoutConfig(document.getElementById("rel-layout").value)
      });

      var self = this;
      this.cy.on("tap", "node", function (evt) {
        self.cy.elements().unselect();
        evt.target.select();
        self.openPanel(evt.target);
        self.focusNeighborhood(evt.target);
      });
      this.cy.on("tap", function (evt) {
        if (evt.target === self.cy) {
          self.cy.elements().unselect();
          self.cy.elements().removeClass("faded");
          self.closePanel();
        }
      });

      this.applyFilters();
    },

    layoutConfig: function (name) {
      var base = { name: name, animate: true, animationDuration: 500, padding: 40, fit: true };
      if (name === "cose") {
        base.nodeRepulsion = function () { return 9000; };
        base.idealEdgeLength = function () { return 120; };
        base.nodeOverlap = 20;
      } else if (name === "concentric") {
        base.concentric = function (n) { return n.data("relationCount") || 0; };
        base.levelWidth = function () { return 2; };
        base.minNodeSpacing = 40;
      } else if (name === "breadthfirst") {
        base.directed = true;
        base.spacingFactor = 1.3;
      } else if (name === "circle" || name === "grid") {
        base.spacingFactor = 1.2;
      }
      return base;
    },

    focusNeighborhood: function (node) {
      var hood = node.closedNeighborhood();
      this.cy.elements().addClass("faded");
      hood.removeClass("faded");
    },

    openPanel: function (node) {
      var d = node.data();
      document.getElementById("panel-title").textContent = d.label;
      document.getElementById("panel-type").textContent = d.ntype === "edge" ? "Edge collection" : "Document collection";
      document.getElementById("panel-docs").textContent = d.count;
      document.getElementById("panel-indexes").textContent = d.indexCount;
      document.getElementById("panel-relations").textContent = d.relationCount;

      var base = "/database/" + encodeURIComponent(DB);
      document.getElementById("panel-browse").href = base + "/documents/" + encodeURIComponent(d.label);
      document.getElementById("panel-idx").href = base + "/indexes/" + encodeURIComponent(d.label);

      var outBox = document.getElementById("panel-out");
      var inBox = document.getElementById("panel-in");
      outBox.innerHTML = "";
      inBox.innerHTML = "";

      var self = this;
      var rowHtml = function (e, dir) {
        var other = dir === "out" ? e.data("target") : e.data("source");
        var arrow = dir === "out" ? "→" : "←";
        var via = e.data("label") ? '<span class="text-text-dim">via</span> <code class="text-accent-light">' + escapeHtml(e.data("label")) + "</code>" : "";
        var dot = e.data("kind") === "graph" ? COLORS.graph : COLORS.fk;
        var div = document.createElement("div");
        div.className = "flex items-center gap-2 px-2 py-1.5 rounded-lg bg-bg-dark/40 border border-border/40 hover:border-primary/40 cursor-pointer transition-colors";
        div.innerHTML =
          '<span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background:' + dot + '"></span>' +
          '<span class="text-text-dim">' + arrow + '</span>' +
          '<span class="text-text font-medium break-all">' + escapeHtml(other) + "</span>" +
          '<span class="text-xs ml-auto">' + via + "</span>";
        div.addEventListener("click", function () {
          var t = self.cy.getElementById(other);
          if (t && t.length) {
            self.cy.elements().unselect();
            t.select();
            self.openPanel(t);
            self.focusNeighborhood(t);
            self.cy.animate({ center: { eles: t }, zoom: Math.max(self.cy.zoom(), 1) }, { duration: 300 });
          }
        });
        return div;
      };

      var outE = node.outgoers("edge");
      var inE = node.incomers("edge");
      if (outE.length === 0) outBox.innerHTML = '<p class="text-text-dim text-xs italic">No outgoing references.</p>';
      outE.forEach(function (e) { outBox.appendChild(rowHtml(e, "out")); });
      if (inE.length === 0) inBox.innerHTML = '<p class="text-text-dim text-xs italic">Not referenced by other collections.</p>';
      inE.forEach(function (e) { inBox.appendChild(rowHtml(e, "in")); });

      document.getElementById("rel-panel").classList.remove("translate-x-full");
    },

    closePanel: function () {
      document.getElementById("rel-panel").classList.add("translate-x-full");
      if (this.cy) {
        this.cy.elements().unselect();
        this.cy.elements().removeClass("faded");
      }
    },

    applyFilters: function () {
      if (!this.cy) return;
      var fk = document.getElementById("toggle-fk").dataset.on === "1";
      var graph = document.getElementById("toggle-graph").dataset.on === "1";
      this.cy.edges().forEach(function (e) {
        var k = e.data("kind");
        var show = (k === "graph" && graph) || (k !== "graph" && fk);
        e.toggleClass("hidden", !show);
      });
    },

    search: function (term) {
      if (!this.cy) return;
      term = (term || "").trim().toLowerCase();
      this.cy.nodes().removeClass("match");
      if (!term) {
        this.cy.elements().removeClass("faded");
        return;
      }
      var matches = this.cy.nodes().filter(function (n) {
        return n.data("label").toLowerCase().indexOf(term) !== -1;
      });
      this.cy.elements().addClass("faded");
      matches.removeClass("faded").addClass("match");
      matches.connectedEdges().removeClass("faded");
      if (matches.length) {
        this.cy.animate({ fit: { eles: matches, padding: 80 } }, { duration: 300 });
      }
    },

    relayout: function () {
      if (!this.cy) return;
      this.cy.layout(this.layoutConfig(document.getElementById("rel-layout").value)).run();
    },

    bindToolbar: function () {
      var self = this;
      document.getElementById("rel-reload").addEventListener("click", function () { self.load(); });
      document.getElementById("toggle-system").addEventListener("change", function () { self.load(); });
      document.getElementById("rel-empty-system").addEventListener("click", function () {
        var sysToggle = document.getElementById("toggle-system");
        sysToggle.checked = true;
        self.load();
      });
      document.getElementById("rel-fit").addEventListener("click", function () { if (self.cy) self.cy.animate({ fit: { padding: 40 } }, { duration: 300 }); });
      document.getElementById("rel-relayout").addEventListener("click", function () { self.relayout(); });
      document.getElementById("rel-layout").addEventListener("change", function () { self.relayout(); });
      document.getElementById("rel-export").addEventListener("click", function () { self.exportPng(); });

      var searchEl = document.getElementById("rel-search");
      var t;
      searchEl.addEventListener("input", function () {
        clearTimeout(t);
        t = setTimeout(function () { self.search(searchEl.value); }, 200);
      });

      ["toggle-fk", "toggle-graph"].forEach(function (id) {
        var btn = document.getElementById(id);
        btn.addEventListener("click", function () {
          btn.dataset.on = btn.dataset.on === "1" ? "0" : "1";
          btn.classList.toggle("opacity-40", btn.dataset.on !== "1");
          self.applyFilters();
        });
      });
    },

    exportPng: function () {
      if (!this.cy) return;
      var png = this.cy.png({ full: true, scale: 2, bg: "#0f172a" });
      var a = document.createElement("a");
      a.href = png;
      a.download = "relationships-" + DB + ".png";
      a.click();
    }
  };

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  window.RelMap = RelMap;

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () { RelMap.init(); });
  } else {
    RelMap.init();
  }
})();
</script>
