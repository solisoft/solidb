<%
  local db = db or "_system"
  local ws_url = ws_url or ""
  local livequery_token = livequery_token or ""
%>
<div class="max-w-6xl mx-auto">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-text">Live Events</h1>
      <p class="text-text-muted text-sm">Real-time change events in <span class="font-medium text-primary-light"><%= db %></span></p>
    </div>

    <!-- Connection Status -->
    <div id="connection-status" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm bg-error/10 text-error">
      <span class="w-2 h-2 rounded-full bg-error"></span>
      <span>Disconnected</span>
    </div>
  </div>

  <!-- Subscription Controls -->
  <div class="bg-bg-card/50 backdrop-blur-sm border border-border/50 rounded-xl p-4 mb-6 overflow-visible relative z-10">
    <h3 class="font-semibold text-text mb-4">Subscribe to Collection</h3>
    <form id="subscribe-form" class="flex flex-col gap-4 overflow-visible">
      <div class="flex flex-col sm:flex-row gap-4">
        <!-- Collection selector -->
        <div class="flex-1 relative">
          <label class="block text-xs text-text-dim mb-1.5">Collection</label>
          <input type="text" id="collection-input" placeholder="Type to search collections..."
                 autocomplete="off"
                 class="w-full px-3 py-2 bg-bg-dark border border-border/50 rounded-lg text-text placeholder-text-dim text-sm focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30">
          <div id="collection-dropdown" class="hidden absolute z-50 w-full mt-1 bg-bg-card border border-border/50 rounded-lg shadow-xl max-h-48 overflow-y-auto">
          </div>
        </div>

        <!-- Key filter -->
        <div class="sm:w-64">
          <label class="block text-xs text-text-dim mb-1.5">Document Key (optional)</label>
          <input type="text" id="key-input" placeholder="Filter by _key..."
                 class="w-full px-3 py-2 bg-bg-dark border border-border/50 rounded-lg text-text placeholder-text-dim text-sm focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30">
        </div>
      </div>

      <div class="flex justify-end">
        <button type="submit" id="toggle-btn"
                class="px-6 py-2 bg-primary hover:bg-primary-light text-white font-medium rounded-lg transition-colors">
          <i class="fas fa-play mr-2"></i>
          <span>Start</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Event Log -->
  <div class="bg-bg-card/50 backdrop-blur-sm border border-border/50 rounded-xl overflow-hidden">
    <div class="border-b border-border/30 px-4 py-3 flex items-center justify-between">
      <h2 class="font-semibold text-text">Event Log</h2>
      <div class="flex items-center gap-3">
        <span id="event-count" class="text-xs text-text-dim">0 events</span>
        <button type="button" id="pause-btn" class="hidden text-xs text-text-muted hover:text-warning transition-colors" title="Pause/Resume">
          <i class="fas fa-pause mr-1"></i> Pause
        </button>
        <button type="button" id="clear-btn" class="text-xs text-text-muted hover:text-text transition-colors">
          <i class="fas fa-eraser mr-1"></i> Clear
        </button>
      </div>
    </div>
    <div id="events-container" class="max-h-[600px] overflow-y-auto">
      <div id="events-placeholder" class="p-8 text-center text-text-muted">
        <i class="fas fa-rss text-3xl mb-3 opacity-50"></i>
        <p>Select a collection and click Start to begin watching events</p>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var wsUrl = '<%= ws_url %>';
  var token = '<%= livequery_token %>';
  var dbName = '<%= db %>';

  var ws = null;
  var isRunning = false;
  var isPaused = false;
  var eventCount = 0;
  var maxEvents = 200;
  var collections = [];

  var form = document.getElementById('subscribe-form');
  var toggleBtn = document.getElementById('toggle-btn');
  var statusEl = document.getElementById('connection-status');
  var eventsContainer = document.getElementById('events-container');
  var eventsPlaceholder = document.getElementById('events-placeholder');
  var eventCountEl = document.getElementById('event-count');
  var clearBtn = document.getElementById('clear-btn');
  var pauseBtn = document.getElementById('pause-btn');
  var collectionInput = document.getElementById('collection-input');
  var collectionDropdown = document.getElementById('collection-dropdown');
  var keyInput = document.getElementById('key-input');

  // Fetch collections for autocomplete
  function fetchCollections() {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', '/database/' + dbName + '/api/collections');
    xhr.onload = function() {
      if (xhr.status === 200) {
        try {
          var data = JSON.parse(xhr.responseText);
          collections = (data.collections || []).map(function(c) {
            return typeof c === 'string' ? c : (c.name || '');
          }).filter(function(n) { return n; }).sort();
        } catch(e) {}
      }
    };
    xhr.send();
  }
  fetchCollections();

  // Autocomplete
  collectionInput.addEventListener('focus', function() {
    showDropdown(collectionInput.value);
  });

  collectionInput.addEventListener('input', function() {
    showDropdown(collectionInput.value);
  });

  document.addEventListener('click', function(e) {
    if (!collectionInput.contains(e.target) && !collectionDropdown.contains(e.target)) {
      collectionDropdown.classList.add('hidden');
    }
  });

  function showDropdown(filter) {
    var filtered = collections.filter(function(c) {
      return !filter || c.toLowerCase().indexOf(filter.toLowerCase()) !== -1;
    });

    if (filtered.length === 0) {
      collectionDropdown.classList.add('hidden');
      return;
    }

    collectionDropdown.innerHTML = filtered.map(function(c) {
      return '<div class="px-3 py-2 text-sm text-text hover:bg-white/10 cursor-pointer transition-colors" data-value="' + escapeAttr(c) + '">' + escapeHtml(c) + '</div>';
    }).join('');
    collectionDropdown.classList.remove('hidden');

    collectionDropdown.querySelectorAll('[data-value]').forEach(function(el) {
      el.addEventListener('click', function() {
        collectionInput.value = this.getAttribute('data-value');
        collectionDropdown.classList.add('hidden');
      });
    });
  }

  function updateStatus(status) {
    var html, classes;
    if (status === 'connected') {
      html = '<span class="w-2 h-2 rounded-full bg-success animate-pulse"></span><span>Connected</span>';
      classes = 'bg-success/10 text-success';
    } else if (status === 'connecting') {
      html = '<span class="w-2 h-2 rounded-full bg-warning animate-pulse"></span><span>Connecting...</span>';
      classes = 'bg-warning/10 text-warning';
    } else {
      html = '<span class="w-2 h-2 rounded-full bg-error"></span><span>Disconnected</span>';
      classes = 'bg-error/10 text-error';
    }
    statusEl.innerHTML = html;
    statusEl.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm ' + classes;
  }

  function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function escapeAttr(text) {
    return text.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function opBadge(operation) {
    var op = operation.toUpperCase();
    if (op === 'INSERT') return '<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-success/10 text-success">INSERT</span>';
    if (op === 'UPDATE') return '<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">UPDATE</span>';
    if (op === 'DELETE') return '<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-error/10 text-error">DELETE</span>';
    return '<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-info/10 text-info">' + escapeHtml(op) + '</span>';
  }

  function addEvent(msg) {
    if (isPaused) return;

    eventCount++;
    eventCountEl.textContent = eventCount + ' events';

    // Remove placeholder
    if (eventsPlaceholder) {
      eventsPlaceholder.remove();
      eventsPlaceholder = null;
    }

    var time = new Date().toLocaleTimeString();
    var dataStr = msg.data ? JSON.stringify(msg.data, null, 2) : '';
    var keyStr = msg.key || '';

    var eventEl = document.createElement('div');
    eventEl.className = 'border-b border-border/20 last:border-0 hover:bg-white/5 transition-colors';

    var header = '<div class="px-4 py-2.5 flex items-center gap-2 cursor-pointer" onclick="this.parentElement.querySelector(\'.event-data\').classList.toggle(\'hidden\')">';
    header += opBadge(msg.operation || 'UNKNOWN');
    header += '<span class="text-sm text-text font-mono">' + escapeHtml(msg.collection || '') + '</span>';
    if (keyStr) {
      header += '<span class="text-xs text-text-dim font-mono">/ ' + escapeHtml(keyStr) + '</span>';
    }
    header += '<span class="text-xs text-text-dim ml-auto">' + escapeHtml(time) + '</span>';
    header += '<i class="fas fa-chevron-down text-xs text-text-dim"></i>';
    header += '</div>';

    var data = '';
    if (dataStr) {
      data = '<div class="event-data hidden px-4 pb-3">';
      data += '<pre class="text-xs text-text-muted font-mono overflow-x-auto whitespace-pre-wrap bg-bg-dark rounded p-3 max-h-64 overflow-y-auto">' + escapeHtml(dataStr) + '</pre>';
      data += '</div>';
    }

    eventEl.innerHTML = header + data;
    eventsContainer.insertBefore(eventEl, eventsContainer.firstChild);

    // Cap at maxEvents
    while (eventsContainer.children.length > maxEvents) {
      eventsContainer.removeChild(eventsContainer.lastChild);
    }
  }

  function connect(collection, key) {
    if (ws) ws.close();

    var url = wsUrl + '?token=' + token + '&db=' + dbName;
    updateStatus('connecting');
    ws = new WebSocket(url);

    ws.onopen = function() {
      var msg = {
        type: 'subscribe',
        collection: collection,
        database: dbName
      };
      if (key) msg.key = key;
      ws.send(JSON.stringify(msg));
    };

    ws.onmessage = function(event) {
      if (event.data === 'PING') return;

      try {
        var msg = JSON.parse(event.data);

        if (msg.type === 'subscribed') {
          updateStatus('connected');
        } else if (msg.operation) {
          addEvent(msg);
        } else if (msg.error) {
          updateStatus('disconnected');
          showToast(msg.error, 'error');
          stop();
        }
      } catch(e) {
        console.warn('Parse error:', e);
      }
    };

    ws.onclose = function() {
      if (isRunning) updateStatus('disconnected');
    };

    ws.onerror = function() {
      updateStatus('disconnected');
    };
  }

  function start() {
    var collection = collectionInput.value.trim();
    if (!collection) {
      showToast('Please select a collection', 'error');
      return;
    }

    isRunning = true;
    isPaused = false;
    toggleBtn.innerHTML = '<i class="fas fa-stop mr-2"></i><span>Stop</span>';
    toggleBtn.classList.remove('bg-primary', 'hover:bg-primary-light');
    toggleBtn.classList.add('bg-error', 'hover:bg-error/80');
    collectionInput.disabled = true;
    collectionInput.classList.add('opacity-50');
    keyInput.disabled = true;
    keyInput.classList.add('opacity-50');
    pauseBtn.classList.remove('hidden');

    var key = keyInput.value.trim() || null;
    connect(collection, key);
  }

  function stop() {
    isRunning = false;
    isPaused = false;
    if (ws) { ws.close(); ws = null; }

    toggleBtn.innerHTML = '<i class="fas fa-play mr-2"></i><span>Start</span>';
    toggleBtn.classList.add('bg-primary', 'hover:bg-primary-light');
    toggleBtn.classList.remove('bg-error', 'hover:bg-error/80');
    collectionInput.disabled = false;
    collectionInput.classList.remove('opacity-50');
    keyInput.disabled = false;
    keyInput.classList.remove('opacity-50');
    pauseBtn.classList.add('hidden');

    updateStatus('disconnected');
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (isRunning) {
      stop();
    } else {
      start();
    }
  });

  clearBtn.addEventListener('click', function() {
    eventsContainer.innerHTML = '<div id="events-placeholder" class="p-8 text-center text-text-muted"><i class="fas fa-rss text-3xl mb-3 opacity-50"></i><p>Waiting for events...</p></div>';
    eventsPlaceholder = document.getElementById('events-placeholder');
    eventCount = 0;
    eventCountEl.textContent = '0 events';
  });

  pauseBtn.addEventListener('click', function() {
    isPaused = !isPaused;
    if (isPaused) {
      pauseBtn.innerHTML = '<i class="fas fa-play mr-1"></i> Resume';
      pauseBtn.classList.add('text-warning');
    } else {
      pauseBtn.innerHTML = '<i class="fas fa-pause mr-1"></i> Pause';
      pauseBtn.classList.remove('text-warning');
    }
  });

  function showToast(message, type) {
    if (typeof htmx !== 'undefined') {
      document.body.dispatchEvent(new CustomEvent('showToast', { detail: { message: message, type: type } }));
    }
  }

  window.addEventListener('beforeunload', function() {
    if (ws) ws.close();
  });
})();
</script>
