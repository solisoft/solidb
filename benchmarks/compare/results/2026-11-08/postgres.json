  "settings": {
    "durable": false,
    "typed": false
  },
  "docs": 1000000,
  "customers": 100000,
  "concurrency": [
    1,
    32
  ],
  "warm_secs": 5,
  "measure_secs": 20,
  "runs": 3,
  "queries": [
    {
      "scenario": "load",
      "query": "INSERT INTO orders (key, doc) SELECT * FROM unnest($1::text[], $2::jsonb[])"
    },
    {
      "scenario": "insert",
      "query": "INSERT INTO orders (key, doc) VALUES ($1, $2)"
    },
    {
      "scenario": "get",
      "query": "SELECT doc FROM orders WHERE key = $1"
    },
    {
      "scenario": "update",
      "query": "UPDATE orders SET doc = jsonb_set(doc, '{status}', to_jsonb($2::text)) WHERE key = $1"
    },
    {
      "scenario": "by_customer",
      "query": "SELECT doc FROM orders WHERE doc->>'customer_id' = $1"
    },
    {
      "scenario": "recent",
      "query": "SELECT doc FROM orders WHERE doc->>'created_at' >= $1 AND doc->>'created_at' < $2 ORDER BY doc->>'created_at' DESC LIMIT 20"
    },
    {
      "scenario": "join",
      "query": "SELECT o.key, (o.doc->>'amount')::float8 AS amount, c.doc->>'name' AS name, c.doc->>'tier' AS tier FROM (SELECT key, doc FROM orders WHERE doc->>'created_at' >= $1 AND doc->>'created_at' < $2 ORDER BY doc->>'created_at' DESC LIMIT 20) o JOIN customers c ON c.key = o.doc->>'customer_id'"
    },
    {
      "scenario": "aggregate",
      "query": "SELECT doc->>'status' AS status, count(*) AS n, sum((doc->>'amount')::float8) AS total FROM orders GROUP BY 1"
    },
    {
      "scenario": "schema",
      "query": "CREATE TABLE orders (key text PRIMARY KEY, doc jsonb NOT NULL)"
    },
    {
      "scenario": "schema",
      "query": "CREATE TABLE customers (key text PRIMARY KEY, doc jsonb NOT NULL)"
    },
    {
      "scenario": "schema",
      "query": "CREATE INDEX idx_customer_id ON orders ((doc->>'customer_id'))"
    },
    {
      "scenario": "schema",
      "query": "CREATE INDEX idx_created_at ON orders ((doc->>'created_at'))"
    },
    {
      "scenario": "schema",
      "query": "CREATE INDEX idx_status ON orders ((doc->>'status'))"
    }
  ],
