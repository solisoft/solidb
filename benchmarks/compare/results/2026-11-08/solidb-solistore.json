  },
  "docs": 1000000,
  "customers": 100000,
  "concurrency": [
    1,
    32
  ],
  "warm_secs": 5,
  "measure_secs": 20,
  "runs": 3,
  "queries": [
    {
      "scenario": "get",
      "query": "driver Get {database, collection: \"orders\", key}"
    },
    {
      "scenario": "update",
      "query": "driver Update {collection: \"orders\", key, document: {status}, merge: true}"
    },
    {
      "scenario": "insert",
      "query": "driver Insert {collection: \"orders\", key, document}"
    },
    {
      "scenario": "load",
      "query": "driver BulkInsert {collection, documents: [1,000 documents]}"
    },
    {
      "scenario": "by_customer",
      "query": "FOR o IN orders FILTER o.customer_id == @c RETURN o"
    },
    {
      "scenario": "recent",
      "query": "FOR o IN orders FILTER o.created_at >= @lo AND o.created_at < @hi SORT o.created_at DESC LIMIT 20 RETURN o"
    },
    {
      "scenario": "join",
      "query": "FOR o IN orders FILTER o.created_at >= @lo AND o.created_at < @hi SORT o.created_at DESC LIMIT 20 LET c = DOCUMENT(CONCAT(\"customers/\", o.customer_id)) RETURN {order: o._key, amount: o.amount, name: c.name, tier: c.tier}"
    },
    {
      "scenario": "aggregate",
      "query": "FOR o IN orders COLLECT status = o.status AGGREGATE n = COUNT(), total = SUM(o.amount) RETURN {status, n, total}"
    },
    {
      "scenario": "indexes",
      "query": "persistent indexes on orders: customer_id, created_at, status"
    }
  ],
