  "queries": [
    {
      "scenario": "load",
      "query": "POST /_db/bench/_api/document/orders?silent=true [1,000 documents]"
    },
    {
      "scenario": "insert",
      "query": "POST /_db/bench/_api/document/orders {document}"
    },
    {
      "scenario": "get",
      "query": "GET /_db/bench/_api/document/orders/{key}"
    },
    {
      "scenario": "update",
      "query": "PATCH /_db/bench/_api/document/orders/{key} {status}"
    },
    {
      "scenario": "by_customer",
      "query": "FOR o IN orders FILTER o.customer_id == @c RETURN o"
    },
    {
      "scenario": "recent",
      "query": "FOR o IN orders FILTER o.created_at >= @lo AND o.created_at < @hi SORT o.created_at DESC LIMIT 20 RETURN o"
    },
    {
      "scenario": "join",
      "query": "FOR o IN orders FILTER o.created_at >= @lo AND o.created_at < @hi SORT o.created_at DESC LIMIT 20 LET c = DOCUMENT(CONCAT(\"customers/\", o.customer_id)) RETURN {order: o._key, amount: o.amount, name: c.name, tier: c.tier}"
    },
    {
      "scenario": "aggregate",
      "query": "FOR o IN orders COLLECT status = o.status AGGREGATE n = COUNT(1), total = SUM(o.amount) RETURN {status, n, total}"
    },
    {
      "scenario": "indexes",
      "query": "persistent indexes on orders: customer_id, created_at, status"
    },
    {
      "scenario": "collections",
      "query": "waitForSync: true"
    }
  ],
