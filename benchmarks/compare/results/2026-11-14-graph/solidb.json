    {
      "scenario": "hop1",
      "query": "FOR v IN 1..1 OUTBOUND @start knows COLLECT AGGREGATE c = COUNT(), s = SUM(v.n) RETURN [c, s]"
    },
    {
      "scenario": "hop2",
      "query": "FOR v IN 1..2 OUTBOUND @start knows COLLECT AGGREGATE c = COUNT(), s = SUM(v.n) RETURN [c, s]"
    },
    {
      "scenario": "hop3",
      "query": "FOR v IN 1..3 OUTBOUND @start knows COLLECT AGGREGATE c = COUNT(), s = SUM(v.n) RETURN [c, s]"
    },
    {
      "scenario": "filtered",
      "query": "LET ns = (FOR v, e IN 2..2 OUTBOUND @start knows OPTIONS { uniqueVertices: \"path\" } FILTER e.since >= @year AND v.country == @country RETURN DISTINCT v.n) RETURN [LENGTH(ns), SUM(ns)]"
    },
    {
      "scenario": "fof_bought",
      "query": "LET buyers = (FOR b IN INBOUND @product bought RETURN b.n) LET ns = (FOR v IN 1..2 OUTBOUND @start knows FILTER v.n IN buyers RETURN v.n) RETURN [LENGTH(ns), SUM(ns)]"
    },
    {
      "scenario": "shortest",
      "query": "FOR v, e, p IN SHORTEST_PATH @from TO @to OUTBOUND knows RETURN LENGTH(p.edges)"
    }
  ],
