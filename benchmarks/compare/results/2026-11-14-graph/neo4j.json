    {
      "scenario": "hop1",
      "query": "MATCH (a:Person {n: $n})-[:KNOWS*1..1]->(b) WHERE b <> a WITH DISTINCT b RETURN count(b) AS c, coalesce(sum(b.n), 0) AS s"
    },
    {
      "scenario": "hop2",
      "query": "MATCH (a:Person {n: $n})-[:KNOWS*1..2]->(b) WHERE b <> a WITH DISTINCT b RETURN count(b) AS c, coalesce(sum(b.n), 0) AS s"
    },
    {
      "scenario": "hop3",
      "query": "MATCH (a:Person {n: $n})-[:KNOWS*1..3]->(b) WHERE b <> a WITH DISTINCT b RETURN count(b) AS c, coalesce(sum(b.n), 0) AS s"
    },
    {
      "scenario": "filtered",
      "query": "MATCH (a:Person {n: $n})-[:KNOWS]->(m)-[e:KNOWS]->(b) WHERE e.since >= $year AND b.country = $country AND b <> a WITH DISTINCT b RETURN count(b) AS c, coalesce(sum(b.n), 0) AS s"
    },
    {
      "scenario": "fof_bought",
      "query": "MATCH (a:Person {n: $n})-[:KNOWS*1..2]->(b)-[:BOUGHT]->(:Product {n: $product}) WHERE b <> a WITH DISTINCT b RETURN count(b) AS c, coalesce(sum(b.n), 0) AS s"
    },
    {
      "scenario": "shortest",
      "query": "MATCH (a:Person {n: $from}), (b:Person {n: $to}) MATCH p = shortestPath((a)-[:KNOWS*..15]->(b)) RETURN length(p) AS l"
    }
  ],
