{
  "engine": "mongo",
  "label": "mongo",
  "server_version": "9.0.4",
  "settings": {
    "durable": false,
    "typed": false
  },
  "docs": 1000000,
  "customers": 100000,
  "concurrency": [
    1,
    32
  ],
  "warm_secs": 5,
  "measure_secs": 20,
  "runs": 3,
  "queries": [
    {
      "scenario": "load",
      "query": "orders.insertMany([1,000 documents], {ordered: false}), write concern server default (w: 1)"
    },
    {
      "scenario": "insert",
      "query": "orders.insertOne(document), write concern server default (w: 1)"
    },
    {
      "scenario": "get",
      "query": "orders.findOne({_id: key})"
    },
    {
      "scenario": "update",
      "query": "orders.updateOne({_id: key}, {$set: {status}}), write concern server default (w: 1)"
    },
    {
      "scenario": "by_customer",
      "query": "orders.find({customer_id: c})"
    },
    {
      "scenario": "recent",
      "query": "orders.find({created_at: {$gte: lo, $lt: hi}}).sort({created_at: -1}).limit(20)"
    },
    {
      "scenario": "join",
      "query": "orders.aggregate([{ \"$match\": { \"created_at\": { \"$gte\": \"lo\", \"$lt\": \"hi\" } } }, { \"$sort\": { \"created_at\": -1 } }, { \"$limit\": 20 }, { \"$lookup\": { \"from\": \"customers\", \"localField\": \"customer_id\", \"foreignField\": \"_id\", \"as\": \"c\" } }, { \"$unwind\": \"$c\" }, { \"$project\": { \"_id\": 1, \"amount\": 1, \"name\": \"$c.name\", \"tier\": \"$c.tier\" } }])"
    },
    {
      "scenario": "aggregate",
      "query": "orders.aggregate([{ \"$group\": { \"_id\": \"$status\", \"n\": { \"$sum\": 1 }, \"total\": { \"$sum\": \"$amount\" } } }])"
    },
    {
      "scenario": "indexes",
      "query": "orders.createIndex({customer_id: 1}), ({created_at: 1}), ({status: 1})"
    }
  ],
