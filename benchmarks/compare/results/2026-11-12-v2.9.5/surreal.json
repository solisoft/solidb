  "queries": [
    {
      "scenario": "load",
      "query": "INSERT INTO orders $docs RETURN NONE"
    },
    {
      "scenario": "insert",
      "query": "INSERT INTO orders $doc RETURN NONE"
    },
    {
      "scenario": "get",
      "query": "SDK select((\"orders\", key))"
    },
    {
      "scenario": "update",
      "query": "UPDATE type::record('orders', $k) SET status = $s RETURN NONE"
    },
    {
      "scenario": "by_customer",
      "query": "SELECT * FROM orders WHERE customer_id = $c"
    },
    {
      "scenario": "recent",
      "query": "SELECT * FROM orders WHERE created_at >= $lo AND created_at < $hi ORDER BY created_at DESC LIMIT 20"
    },
    {
      "scenario": "join",
      "query": "SELECT id, amount, customer.name AS name, customer.tier AS tier FROM orders WHERE created_at >= $lo AND created_at < $hi ORDER BY created_at DESC LIMIT 20"
    },
    {
      "scenario": "aggregate",
      "query": "SELECT status, count() AS n, math::sum(amount) AS total FROM orders GROUP BY status"
    },
    {
      "scenario": "schema",
      "query": "REMOVE TABLE IF EXISTS orders"
    },
    {
      "scenario": "schema",
      "query": "REMOVE TABLE IF EXISTS customers"
    },
    {
      "scenario": "schema",
      "query": "DEFINE TABLE orders SCHEMALESS"
    },
    {
      "scenario": "schema",
      "query": "DEFINE TABLE customers SCHEMALESS"
    },
    {
      "scenario": "schema",
      "query": "DEFINE FIELD customer ON orders VALUE type::record('customers', customer_id)"
    },
    {
      "scenario": "schema",
      "query": "DEFINE INDEX idx_customer_id ON orders FIELDS customer_id"
    },
    {
      "scenario": "schema",
      "query": "DEFINE INDEX idx_created_at ON orders FIELDS created_at"
    },
    {
      "scenario": "schema",
      "query": "DEFINE INDEX idx_status ON orders FIELDS status"
    }
  ],
