+/// Exact vectors of a quantized index, on disk (card #1007):
+/// `vexact:<len>:<index>:<document key>` -> the vector as little-endian f32.
+/// Re-scoring read each candidate's document and decoded it to take its
+/// vector: about 45% of a PQ search. The index name carries its length so
+/// that one index's range never covers another's.
+pub(crate) const VEXACT_PREFIX: &str = "vexact:";
+
+fn exact_prefix(index: &str) -> String {
+    format!("{VEXACT_PREFIX}{}:{index}:", index.len())
+}
+
+fn exact_key(index: &str, doc_key: &str) -> String {
+    format!("{}{doc_key}", exact_prefix(index))
+}
+
+fn exact_bytes(vector: &[f32]) -> Vec<u8> {
+    vector.iter().flat_map(|x| x.to_le_bytes()).collect()
+}
+
+fn exact_vector(bytes: &[u8], dim: usize) -> Option<Vec<f32>> {
+    (bytes.len() == dim * 4).then(|| {
+        bytes
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .map(|b| f32::from_le_bytes(*b))
+            .collect()
+    })
+}
