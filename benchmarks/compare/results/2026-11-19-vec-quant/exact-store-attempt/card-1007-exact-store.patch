     use crate::storage::StorageEngine;
     use serde_json::json;
 
+    /// Card #1007: a quantized index keeps its exact vectors on disk for
+    /// re-scoring, in step with every write, and only while quantized.
+    #[test]
+    fn a_quantized_index_keeps_its_exact_vectors() {
+        use super::{exact_key, exact_vector};
+        use crate::storage::index::VectorQuantization;
+        use crate::storage::keyspace::KsDbExt;
+        use crate::storage::VectorIndexConfig;
+        let tmp = tempfile::TempDir::new().unwrap();
+        let engine = StorageEngine::new(tmp.path().to_str().unwrap()).unwrap();
+        engine.create_database("d".to_string()).unwrap();
+        let db = engine.get_database("d").unwrap();
+        db.create_collection("c".to_string(), None).unwrap();
+        let coll = db.get_collection("c").unwrap();
+        let docs: Vec<serde_json::Value> = (0..10_200)
+            .map(|i| {
+                let x = i as f64 / 10_200.0;
+                json!({"_key": format!("k{i}"), "emb": [x, 1.0 - x, 0.5, 0.25]})
+            })
+            .collect();
+        coll.insert_batch(docs).unwrap();
+        let stored = |key: &str| -> Option<Vec<f32>> {
+            let cf = coll.ks.handle(&coll.db).unwrap();
+            coll.db
+                .get_ks(&cf, exact_key("idx", key).as_bytes())
+                .unwrap()
+                .and_then(|b| exact_vector(&b, 4))
+        };
+        coll.create_vector_index(
+            VectorIndexConfig::new("idx".to_string(), "emb".to_string(), 4)
+                .with_quantization(VectorQuantization::Pq),
+        )
+        .unwrap();
+        assert!(coll.get_vector_index("idx").unwrap().graph_is_quantized());
+        assert_eq!(stored("k0"), Some(vec![0.0, 1.0, 0.5, 0.25]));
+        assert!(stored("k10199").is_some());
+
+        // A write and a delete follow.
+        coll.update("k0", json!({"emb": [0.5, 0.5, 0.5, 0.5]}))
+            .unwrap();
+        assert_eq!(stored("k0"), Some(vec![0.5, 0.5, 0.5, 0.5]));
+        coll.delete("k1").unwrap();
+        assert_eq!(stored("k1"), None);
+        // Searches re-score from them: every score is the exact cosine of
+        // the stored vector (which candidates come back is the codes' call,
+        // and four dimensions make one coarse sub-vector).
+        let q = [0.3f32, 0.7, 0.5, 0.25];
+        let found = coll.vector_search("idx", &q, 5, None).unwrap();
+        assert_eq!(found.len(), 5);
+        for r in &found {
+            let v = stored(&r.doc_key).unwrap();
+            let exact = crate::storage::vector::cosine_similarity(&q, &v);
+            assert!((r.score - exact).abs() < 1e-6, "{r:?} vs {exact}");
+        }
+
+        // Gone with the quantization, and with the documents.
+        coll.dequantize_vector_index("idx").unwrap();
+        assert_eq!(stored("k2"), None);
+        coll.quantize_vector_index("idx", VectorQuantization::Scalar)
+            .unwrap();
+        assert!(stored("k2").is_some());
+        coll.truncate().unwrap();
+        assert_eq!(stored("k2"), None);
+    }
