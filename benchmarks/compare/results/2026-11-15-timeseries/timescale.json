  "queries": [
    {
      "scenario": "range",
      "query": "SELECT count(*), coalesce(sum(v), 0)::float8 FROM points WHERE series = $1 AND ts >= to_timestamp($2) AND ts < to_timestamp($3)"
    },
    {
      "scenario": "bucket",
      "query": "SELECT avg(v)::float8 FROM points WHERE series = $1 AND ts >= to_timestamp($2) AND ts < to_timestamp($3) GROUP BY time_bucket('5 minutes', ts)"
    },
    {
      "scenario": "last",
      "query": "SELECT (extract(epoch FROM ts) * 1000)::bigint, v FROM points WHERE series = $1 ORDER BY ts DESC LIMIT 1"
    },
    {
      "scenario": "window_all",
      "query": "SELECT count(*), coalesce(sum(v), 0)::float8 FROM points WHERE ts >= to_timestamp($1) AND ts < to_timestamp($2)"
    },
    {
      "scenario": "insert",
      "query": "INSERT INTO points SELECT s, to_timestamp(t), v FROM unnest($1::text[], $2::float8[], $3::float8[]) AS u(s, t, v)"
    }
  ],
