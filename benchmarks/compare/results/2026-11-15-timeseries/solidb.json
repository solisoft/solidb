  "queries": [
    {
      "scenario": "range",
      "query": "FOR p IN points FILTER p.series == @s AND p.ts >= @lo AND p.ts < @hi COLLECT AGGREGATE c = COUNT(), t = SUM(p.v) RETURN [c, t]"
    },
    {
      "scenario": "bucket",
      "query": "FOR p IN points FILTER p.series == @s AND p.ts >= @lo AND p.ts < @hi COLLECT b = TIME_BUCKET(p.ts, \"5m\") AGGREGATE a = AVG(p.v) RETURN a"
    },
    {
      "scenario": "last",
      "query": "FOR p IN points FILTER p.series == @s SORT p.ts DESC LIMIT 1 RETURN [p.ts, p.v]"
    },
    {
      "scenario": "window_all",
      "query": "FOR p IN points FILTER p.ts >= @lo AND p.ts < @hi COLLECT AGGREGATE c = COUNT(), t = SUM(p.v) RETURN [c, t]"
    },
    {
      "scenario": "insert",
      "query": "bulk_insert of one document {series, ts, v}"
    }
  ],
