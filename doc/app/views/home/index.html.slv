<ol class="perf-rows" aria-label="Two hops, filtered by year and country, requests/s, 8 clients">
<li class="perf-row is-solidb"><span>SoliDB</span><span class="perf-track"><span class="perf-bar" style="--w: 1.000" aria-hidden="true"></span><span class="perf-val">74,274</span></span></li>
<li class="perf-row"><span>Memgraph</span><span class="perf-track"><span class="perf-bar" style="--w: 0.742" aria-hidden="true"></span><span class="perf-val">55,131</span></span></li>
