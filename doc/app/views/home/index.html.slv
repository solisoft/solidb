<script>
  // Hero slideshow: tabs name the features, arrows step through them, and it
  // advances on its own every 8 s unless the reader prefers reduced motion,
  // pauses it, or is hovering / focused inside it.
  (function () {
    var root = document.querySelector("[data-slideshow]");
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    var slides = Array.prototype.slice.call(root.querySelectorAll(".slide"));
    var indexLabel = root.querySelector("[data-index]");
    var toggle = root.querySelector("[data-toggle]");
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var current = 0, timer = null, paused = reduceMotion, held = false;
    var DELAY = 8000;

    function show(i, focusTab) {
      current = (i + slides.length) % slides.length;
      slides.forEach(function (slide, n) {
        var on = n === current;
        slide.classList.toggle("is-active", on);
        slide.setAttribute("aria-hidden", on ? "false" : "true");
        tabs[n].setAttribute("aria-selected", on ? "true" : "false");
        tabs[n].tabIndex = on ? 0 : -1;
      });
      indexLabel.textContent = current + 1;
      if (focusTab) tabs[current].focus();
      restart();
    }
    function restart() {
      clearTimeout(timer);
      root.classList.remove("is-running");
      if (paused || held) return;
      void root.offsetWidth; // restart the progress underline
      root.classList.add("is-running");
      timer = setTimeout(function () { show(current + 1); }, DELAY);
    }
    function setPaused(p) {
      paused = p;
      root.classList.toggle("is-paused", p);
      toggle.setAttribute("aria-pressed", p ? "true" : "false");
      toggle.setAttribute("aria-label", p ? "Play the slideshow" : "Pause the slideshow");
      restart();
    }

    tabs.forEach(function (tab, n) {
      tab.addEventListener("click", function () { show(n); });
      tab.addEventListener("keydown", function (e) {
        if (e.key === "ArrowRight") { e.preventDefault(); show(current + 1, true); }
        if (e.key === "ArrowLeft")  { e.preventDefault(); show(current - 1, true); }
        if (e.key === "Home")       { e.preventDefault(); show(0, true); }
        if (e.key === "End")        { e.preventDefault(); show(slides.length - 1, true); }
      });
    });
    root.querySelector("[data-prev]").addEventListener("click", function () { show(current - 1); });
    root.querySelector("[data-next]").addEventListener("click", function () { show(current + 1); });
    toggle.addEventListener("click", function () { setPaused(!paused); });
    function hold(h) { held = h; restart(); }
    root.addEventListener("mouseenter", function () { hold(true); });
    root.addEventListener("mouseleave", function () { hold(false); });
    root.addEventListener("focusin", function () { hold(true); });
    root.addEventListener("focusout", function (e) { if (!root.contains(e.relatedTarget)) hold(false); });

    root.classList.add("is-ready");
    setPaused(paused);
    show(0);
  })();
</script>
