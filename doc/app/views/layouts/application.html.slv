<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
<% description = "SoliDB is a fast, lightweight multi-model database written in Rust — " +
    "documents, graph, vector, time-series and columnar storage behind one SDBQL " +
    "query engine, with live queries, replication and sharding." %>
<% share_title = "SoliDB — a multi-model database in a single Rust binary" %>
<% share_image = site_url(public_path("images/og-cover.png")) %>
<% page_url = site_url(current_path() ?? "/") %>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= page_url %>">

    <!-- Social share card — regenerate the image with ./tools/og/build.sh -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="SoliDB">
    <meta property="og:url" content="<%= page_url %>">
    <meta property="og:title" content="<%= share_title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="<%= share_image %>">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="SoliDB: documents, graphs, vectors and time-series in one database. Beside it, each data model with the SDBQL that queries it: FOR … FILTER, OUTBOUND, VECTOR_SIMILARITY, FULLTEXT, GEO_DISTANCE and TIME_BUCKET.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= share_title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= share_image %>">
    <%- partial("shared/theme_head", {}) %>
    <!-- Tailwind CSS (compiled): npm run build:css -->
    <link rel="stylesheet" href="<%= public_path("css/application.css") %>">
</head>
<body class="soli-body">
    <%= yield %>

    <!-- HTMx + Alpine.js (Soli's default client stack — see /docs/core-concepts/client-interactivity) -->
    <script defer src="<%= public_path("js/htmx.min.js") %>"></script>
    <script defer src="<%= public_path("js/alpine.min.js") %>"></script>
</body>
</html>
