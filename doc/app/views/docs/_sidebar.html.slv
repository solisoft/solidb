<%# Docs navigation. `current_page` is passed in by the docs layout. The IA
    mirrors the original www docs site; active groups render their subitems. %>
<%
sections = docs_nav()
%>

<nav class="sb">
  <a href="/docs" class="sb-home <%= current_page == "index" ? "active" : "" %>">
    <i class="fas fa-house"></i>
    <span>Documentation Home</span>
  </a>

  <% for section in sections %>
    <div class="sb-sec">
      <div class="sb-sec-title"><%= section["title"] %></div>
      <% for item in section["items"] %>
        <a href="/docs/<%= item["slug"] %>" class="sb-link <%= doc_group_active(item, current_page) ? "active" : "" %>">
          <i class="fas <%= item["icon"] %>"></i>
          <span><%= item["label"] %></span>
          <% if item["subitems"].present? %><i class="fas fa-chevron-down chev"></i><% end %>
        </a>
        <% if item["subitems"].present? and doc_group_active(item, current_page) %>
          <div class="sb-sub">
            <% for sub in item["subitems"] %>
              <a href="/docs/<%= sub["slug"] %>" class="sb-sublink <%= current_page == sub["slug"] ? "active" : "" %>"><%= sub["label"] %></a>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</nav>
