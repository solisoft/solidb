<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <a href="/docs/api" class="inline-flex items-center text-indigo-400 hover:text-indigo-300 font-medium transition-colors group">
      <svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to API Reference
    </a>
  </div>

  <div class="lg:grid lg:grid-cols-12 lg:gap-12">
    <main class="lg:col-span-12 space-y-12">

       <section id="scripts" class="scroll-mt-24">
         <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
               Lua Scripts Management
            </h2>
          </div>
          <div class="divide-y divide-white/5">
             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-4">
                <span class="px-2 py-1 bg-green-500/20 text-green-400 text-xs font-bold rounded">POST</span>
                <code class="text-gray-300">/_api/database/:db/scripts</code>
              </div>
              <p class="text-sm text-gray-400 mb-4">Register a new Lua script.</p>

               <div class="mb-4">
                 <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Request Body Options</h4>
                 <div class="bg-gray-950/50 rounded-lg overflow-hidden border border-white/5">
                   <table class="w-full text-left text-xs">
                     <thead class="bg-white/5 text-gray-300 font-bold border-b border-white/5">
                       <tr>
                         <th class="p-3">Field</th>
                         <th class="p-3">Type</th>
                         <th class="p-3">Description</th>
                         <th class="p-3">Required</th>
                       </tr>
                     </thead>
                     <tbody class="text-gray-400 divide-y divide-white/5">
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">name</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Friendly name of the script.</td>
                         <td class="p-3 text-white">Yes</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">path</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Path under the service (e.g. "greet" or "users/:id"). <code>:segment</code> parts are exposed as <code>request.params</code>.</td>
                         <td class="p-3 text-white">Yes</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">methods</td>
                         <td class="p-3 font-mono">array</td>
                         <td class="p-3">Allowed methods: any of "GET", "POST", "PUT", "DELETE", or "WS" for a WebSocket handler.</td>
                         <td class="p-3 text-white">Yes</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">code</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">The Lua source code.</td>
                         <td class="p-3 text-white">Yes</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">service</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Service the script is published under. Default: "default". The service must already exist.</td>
                         <td class="p-3 text-white">No</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">description</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Free text, shown in listings and the OpenAPI document.</td>
                         <td class="p-3 text-white">No</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">collection</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Collection the script primarily works on (metadata only).</td>
                         <td class="p-3 text-white">No</td>
                       </tr>
                     </tbody>
                   </table>
                 </div>
               </div>

                <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                 {"name": "Greeter", "path": "greet/:name", "methods": ["GET"], "service": "default", "code": "return {msg='hi ' .. request.params.name}"}
               </div>

               <div class="mt-4 mb-4">
                 <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Response</h4>
                 <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                   <div class="flex items-center gap-2 mb-2 border-b border-white/5 pb-2">
                      <span class="text-emerald-400 font-bold">200 OK</span>
                      <span class="text-gray-500 text-[10px] uppercase tracking-wider">application/json</span>
                   </div>
                   <div class="whitespace-pre">{
  "id": "019c243e-9d0b-756c-be78-e4cad62fa2a1",
  "name": "Greeter",
  "path": "greet/:name",
  "methods": ["GET"],
  "service": "default",
  "created_at": "2026-09-03T10:15:00Z"
}</div>
                 </div>
               </div>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold rounded">GET</span>
                <code class="text-gray-300">/_api/database/:db/scripts</code>
              </div>
              <p class="text-sm text-gray-400">List all registered scripts.</p>

               <div class="mt-4 mb-4">
                 <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Response</h4>
                 <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                   <div class="flex items-center gap-2 mb-2 border-b border-white/5 pb-2">
                      <span class="text-emerald-400 font-bold">200 OK</span>
                      <span class="text-gray-500 text-[10px] uppercase tracking-wider">application/json</span>
                   </div>
                   <div class="whitespace-pre">[
  {
    "id": "019c243e-9d0b-756c-be78-e4cad62fa2a1",
    "name": "Greeter",
    "path": "greet/:name",
    "methods": ["GET"],
    "description": null,
    "database": "mydb",
    "service": "default",
    "collection": null,
    "created_at": "2026-09-03T10:15:00Z",
    "updated_at": "2026-09-03T10:15:00Z"
  }
]</div>
                 </div>
               </div>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold rounded">GET</span>
                <code class="text-gray-300">/_api/database/:db/scripts/:id</code>
              </div>
              <p class="text-sm text-gray-400">Get one script, including its <code>code</code>.</p>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 text-xs font-bold rounded">PUT</span>
                <code class="text-gray-300">/_api/database/:db/scripts/:id</code>
              </div>
              <p class="text-sm text-gray-400">Update an existing script. Same body as create; the new code is used from the next request on.</p>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-red-500/20 text-red-400 text-xs font-bold rounded">DELETE</span>
                <code class="text-gray-300">/_api/database/:db/scripts/:id</code>
              </div>
              <p class="text-sm text-gray-400">Delete a script.</p>
            </div>

            <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold rounded">GET</span>
                <code class="text-gray-300">/_api/scripts/stats</code>
              </div>
              <p class="text-sm text-gray-400">Instance-wide script counters (global Admin only).</p>
               <div class="mt-4 mb-4">
                 <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Response</h4>
                 <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                   <div class="flex items-center gap-2 mb-2 border-b border-white/5 pb-2">
                      <span class="text-emerald-400 font-bold">200 OK</span>
                      <span class="text-gray-500 text-[10px] uppercase tracking-wider">application/json</span>
                   </div>
                   <div class="whitespace-pre">{
  "active_scripts": 2,
  "active_ws": 5,
  "total_scripts_executed": 1234,
  "total_ws_connections": 87
}</div>
                 </div>
               </div>
            </div>

            <!-- Custom Lua API Execution -->
            <div class="p-6 hover:bg-white/5 transition-colors border-t border-white/5">
               <div class="flex items-center gap-3 mb-4">
                <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold rounded">GET</span>
                <span class="px-2 py-1 bg-green-500/20 text-green-400 text-xs font-bold rounded">POST</span>
                <span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 text-xs font-bold rounded">PUT</span>
                <span class="px-2 py-1 bg-red-500/20 text-red-400 text-xs font-bold rounded">DELETE</span>
                <code class="text-gray-300">/api/:db/:service/*path</code>
              </div>
              <p class="text-sm text-gray-400 mb-4">Execute a registered Lua script: database first, then service, then the script's registered path. Request body, query parameters, headers and <code>:param</code> segments are passed to the script as <code>request</code>. Only methods listed in the script's <code>methods</code> are accepted. WebSocket handlers (<code>"WS"</code>) are reached at the same URL over <code>ws://</code>.</p>
              <p class="text-xs text-gray-500 mb-4">Unknown service: <code>404</code>. Disabled service: <code>400</code>. Service with <code>require_auth</code> and no credentials: <code>401</code> before the script runs. A plain return value is sent as JSON 200; <code>response.*</code> constructors and <code>solidb.error</code> set other statuses.</p>
              <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                <span class="text-gray-500">// Example: GET /api/mydb/default/greet/Alice?verbose=1</span><br>
                <span class="text-gray-500">// Calls the script registered as "greet/:name" in service "default"</span><br>
                <span class="text-gray-500">// request.params.name == "Alice", request.query.verbose == "1"</span>
              </div>
               <div class="mt-4 mb-4">
                 <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Response</h4>
                 <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                   <div class="flex items-center gap-2 mb-2 border-b border-white/5 pb-2">
                      <span class="text-emerald-400 font-bold">200 OK</span>
                      <span class="text-gray-500 text-[10px] uppercase tracking-wider">application/json</span>
                   </div>
                   <span class="text-gray-500">// Response depends on script return value</span><br>
                   { "msg": "hi Alice" }
                 </div>
               </div>
            </div>
          </div>
        </div>
      </section>


       <section id="services" class="scroll-mt-24">
         <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
               Services
            </h2>
          </div>
          <div class="divide-y divide-white/5">
            <div class="p-6">
              <p class="text-sm text-gray-400">
                A service is the <code class="text-fuchsia-400">{service}</code> segment scripts are published under. It must exist before any of its scripts can be invoked; a missing service answers <code>404</code>, a disabled one <code>400</code>.
                Services are stored in <code>_services</code> and only writable through these Admin endpoints. See the <a href="/docs/scripting-services" class="text-indigo-400 hover:text-indigo-300">Services</a> guide.
              </p>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-4">
                <span class="px-2 py-1 bg-green-500/20 text-green-400 text-xs font-bold rounded">POST</span>
                <code class="text-gray-300">/_api/database/:db/services</code>
              </div>
              <p class="text-sm text-gray-400 mb-4">Create a service.</p>
               <div class="mb-4">
                 <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Request Body Options</h4>
                 <div class="bg-gray-950/50 rounded-lg overflow-hidden border border-white/5">
                   <table class="w-full text-left text-xs">
                     <thead class="bg-white/5 text-gray-300 font-bold border-b border-white/5">
                       <tr>
                         <th class="p-3">Field</th>
                         <th class="p-3">Type</th>
                         <th class="p-3">Description</th>
                         <th class="p-3">Required</th>
                       </tr>
                     </thead>
                     <tbody class="text-gray-400 divide-y divide-white/5">
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">key</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Identifier used in URLs (e.g. "default").</td>
                         <td class="p-3 text-white">Yes</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">name</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Display name.</td>
                         <td class="p-3 text-white">Yes</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">description</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Free text, copied into the OpenAPI document.</td>
                         <td class="p-3 text-white">No</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">version</td>
                         <td class="p-3 font-mono">string</td>
                         <td class="p-3">Version label (e.g. "1.2.0").</td>
                         <td class="p-3 text-white">No</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">enabled</td>
                         <td class="p-3 font-mono">boolean</td>
                         <td class="p-3">Whether scripts in this service can be invoked. Default: true.</td>
                         <td class="p-3 text-white">No</td>
                       </tr>
                       <tr>
                         <td class="p-3 text-fuchsia-400 font-mono">require_auth</td>
                         <td class="p-3 font-mono">boolean</td>
                         <td class="p-3">Reject unauthenticated callers with 401 before the script runs. Default: true.</td>
                         <td class="p-3 text-white">No</td>
                       </tr>
                     </tbody>
                   </table>
                 </div>
               </div>
               <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                 {"key": "shop", "name": "Shop API", "version": "1.0.0", "require_auth": false}
               </div>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold rounded">GET</span>
                <code class="text-gray-300">/_api/database/:db/services</code>
              </div>
              <p class="text-sm text-gray-400">List services of the database.</p>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold rounded">GET</span>
                <code class="text-gray-300">/_api/database/:db/services/:key</code>
              </div>
              <p class="text-sm text-gray-400">Get one service.</p>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 text-xs font-bold rounded">PUT</span>
                <code class="text-gray-300">/_api/database/:db/services/:key</code>
              </div>
              <p class="text-sm text-gray-400">Update a service (same body as create; <code>key</code> is taken from the URL).</p>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-red-500/20 text-red-400 text-xs font-bold rounded">DELETE</span>
                <code class="text-gray-300">/_api/database/:db/services/:key</code>
              </div>
              <p class="text-sm text-gray-400">Delete a service. Its scripts stay in <code>_scripts</code> but stop being reachable.</p>
            </div>

             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold rounded">GET</span>
                <code class="text-gray-300">/_api/database/:db/services/:key/openapi</code>
              </div>
              <p class="text-sm text-gray-400">OpenAPI 3 document for the service. Every HTTP script becomes a path of the form <code>/api/{db}/{service}/{path}</code> with one operation per method; scripts whose only method is <code>WS</code> are omitted.</p>
            </div>
          </div>
        </div>
      </section>

       <section id="repl" class="scroll-mt-24">
         <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
               Lua REPL
            </h2>
          </div>
          <div class="divide-y divide-white/5">
             <div class="p-6 hover:bg-white/5 transition-colors">
               <div class="flex items-center gap-3 mb-4">
                <span class="px-2 py-1 bg-green-500/20 text-green-400 text-xs font-bold rounded">POST</span>
                <code class="text-gray-300">/_api/database/:db/repl</code>
              </div>
              <p class="text-sm text-gray-400 mb-4">Evaluate a Lua snippet against the database with the same globals a script sees (<code>db</code>, <code>solidb</code>, <code>json</code>, ...). Requires Write permission on the database; the code runs as the caller, exactly like a script.</p>
              <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                {"code": "return db:collection('users'):count()", "session_id": "optional", "timeout_ms": 5000}
              </div>
               <div class="mt-4 mb-4">
                 <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Response</h4>
                 <div class="bg-gray-950/50 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                   <div class="flex items-center gap-2 mb-2 border-b border-white/5 pb-2">
                      <span class="text-emerald-400 font-bold">200 OK</span>
                      <span class="text-gray-500 text-[10px] uppercase tracking-wider">application/json</span>
                   </div>
                   <div class="whitespace-pre">{
  "result": 42,
  "output": [],
  "error": null,
  "execution_time_ms": 0.8,
  "session_id": "b1f3..."
}</div>
                 </div>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Navigation -->
      <div class="flex justify-between items-center pt-8 border-t border-white/10">
        <a href="/docs/api-indexes" class="text-gray-400 hover:text-white transition-colors">
          <span class="flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Indexes
          </span>
        </a>
        <a href="/docs/api-blobs" class="text-indigo-400 hover:text-indigo-300 transition-colors">
          <span class="flex items-center">
            Blobs
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>
      </div>

    </main>
  </div>
</div>
