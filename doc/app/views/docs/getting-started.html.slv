<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-8">
    <a
      href="/docs"
      class="inline-flex items-center text-indigo-400 hover:text-indigo-300 font-medium transition-colors group"
    >
      <svg
        class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"
        ></path>
      </svg>
      Back to Documentation
    </a>
    <a href="/docs/changelog" class="ml-4 text-sm text-emerald-400 hover:text-emerald-300">View full Changelog →</a>
  </div>

  <div class="grid grid-cols-12 gap-8 lg:gap-12">
    <!-- Sidebar Partial -->

    <!-- Main Content -->
    <main class="col-span-12 lg:col-span-12 space-y-12">
      <!-- Header Section -->
      <div class="relative">
        <div
          class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-lg blur opacity-25"
        ></div>
        <div class="relative">
          <h1
            class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400 mb-4 tracking-tight"
          >
            Getting Started
          </h1>
          <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
            Get up and running with SoliDB in minutes. Learn the basics of
            installation, connecting, and running your first queries.
          </p>
        </div>
      </div>

      <!-- Installation Section -->
      <section id="installation" class="scroll-mt-24">
        <div
          class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl"
        >
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg
                class="w-6 h-6 mr-3 text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                ></path>
              </svg>
              Installation
            </h2>
          </div>

          <div class="p-8 space-y-8">
            <div class="group">
              <h3
                class="text-lg font-semibold text-white mb-3 flex items-center"
              >
                <span
                  class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-sm font-bold mr-3 border border-emerald-500/30"
                  >1</span
                >
                Quick Install (Recommended)
              </h3>
              <div
                class="bg-gray-950/50 rounded-xl border border-white/5 p-4 group-hover:border-emerald-500/30 transition-colors"
              >
                <div class="flex items-center justify-between mb-2">
                  <span
                    class="text-xs font-bold text-gray-500 uppercase tracking-widest"
                    >Terminal</span
                  >
                  <button
                    class="text-gray-500 hover:text-white transition-colors"
                    onclick="navigator.clipboard.writeText('curl -sSL https://raw.githubusercontent.com/solisoft/solidb/main/install.sh | sh')"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                      ></path>
                    </svg>
                  </button>
                </div>
                <code class="font-mono text-sm text-emerald-300"
                  >curl -sSL https://raw.githubusercontent.com/solisoft/solidb/main/install.sh | sh</code
                >
              </div>
              <div class="mt-4 bg-emerald-900/20 border border-emerald-500/20 rounded-lg p-3">
                <p class="text-sm text-emerald-200">
                  Installs the latest pre-built binary to <code class="text-emerald-400">~/.local/bin</code>. Use <code class="text-emerald-400">--system</code> flag for system-wide install to <code class="text-emerald-400">/usr/local/bin</code>.
                </p>
              </div>
            </div>

            <div class="group">
              <h3
                class="text-lg font-semibold text-white mb-3 flex items-center"
              >
                <span
                  class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-sm font-bold mr-3 border border-blue-500/30"
                  >2</span
                >
                Using Cargo
              </h3>
              <div
                class="bg-gray-950/50 rounded-xl border border-white/5 p-4 group-hover:border-blue-500/30 transition-colors"
              >
                <div class="flex items-center justify-between mb-2">
                  <span
                    class="text-xs font-bold text-gray-500 uppercase tracking-widest"
                    >Terminal</span
                  >
                  <button
                    class="text-gray-500 hover:text-white transition-colors"
                    onclick="navigator.clipboard.writeText('cargo install solidb')"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                      ></path>
                    </svg>
                  </button>
                </div>
                <code class="font-mono text-sm text-blue-300"
                  >cargo install solidb</code
                >
              </div>
            </div>

            <div class="group">
              <h3
                class="text-lg font-semibold text-white mb-3 flex items-center"
              >
                <span
                  class="w-8 h-8 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center text-sm font-bold mr-3 border border-purple-500/30"
                  >3</span
                >
                From Source
              </h3>
              <div
                class="bg-gray-950/50 rounded-xl border border-white/5 p-4 group-hover:border-purple-500/30 transition-colors"
              >
                <div class="flex items-center justify-between mb-2">
                  <span
                    class="text-xs font-bold text-gray-500 uppercase tracking-widest"
                    >Terminal</span
                  >
                </div>
                <div class="space-y-2 font-mono text-sm">
                  <div class="flex">
                    <span class="text-purple-400 mr-2">$</span
                    ><span class="text-gray-300"
                      >git clone https://github.com/solisoft/solidb</span
                    >
                  </div>
                  <div class="flex">
                    <span class="text-purple-400 mr-2">$</span
                    ><span class="text-gray-300">cd solidb</span>
                  </div>
                  <div class="flex">
                    <span class="text-purple-400 mr-2">$</span
                    ><span class="text-gray-300">cargo build --release</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="group">
              <h3
                class="text-lg font-semibold text-white mb-3 flex items-center"
              >
                <span
                  class="w-8 h-8 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-sm font-bold mr-3 border border-cyan-500/30"
                  >4</span
                >
                Using Docker
              </h3>
              <div
                class="bg-gray-950/50 rounded-xl border border-white/5 p-4 group-hover:border-cyan-500/30 transition-colors"
              >
                <div class="flex items-center justify-between mb-2">
                  <span
                    class="text-xs font-bold text-gray-500 uppercase tracking-widest"
                    >Terminal</span
                  >
                </div>
                <div class="space-y-2 font-mono text-sm">
                  <div class="flex">
                    <span class="text-cyan-400 mr-2">$</span
                    ><span class="text-gray-300"
                      >docker run -d --name solidb \</span
                    >
                  </div>
                  <div class="flex pl-6">
                    <span class="text-gray-300"
                      >-p 6745:6745 \</span
                    >
                  </div>
                  <div class="flex pl-6">
                    <span class="text-gray-300"
                      >-v solidb-data:/data \</span
                    >
                  </div>
                  <div class="flex pl-6">
                    <span class="text-gray-300"
                      >ghcr.io/solisoft/solidb:latest</span
                    >
                  </div>
                </div>
              </div>
              <div class="mt-4 bg-cyan-900/20 border border-cyan-500/20 rounded-lg p-3">
                <p class="text-sm text-cyan-200">
                  <strong>Docker Compose:</strong> For production deployments, use docker-compose.yml from the repository.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Docker Section -->
      <section id="docker" class="scroll-mt-24">
        <div
          class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl"
        >
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg
                class="w-6 h-6 mr-3 text-cyan-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
                ></path>
              </svg>
              Docker Deployment
            </h2>
          </div>

          <div class="p-8 space-y-8">
            <p class="text-gray-300 leading-relaxed">
              SoliDB publishes official Docker images to the GitHub Container Registry at
              <code class="text-cyan-400">ghcr.io/solisoft/solidb</code> for easy deployment in containerized environments.
              Images are tagged <code class="text-cyan-400">:latest</code> and per release (e.g. <code class="text-cyan-400">:v0.31.0</code>).
              If the package is private, run <code class="text-cyan-400">docker login ghcr.io</code> with a token that has <code class="text-cyan-400">read:packages</code> first.
            </p>

            <!-- Docker Compose -->
            <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
              <h3 class="text-cyan-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Docker Compose (Recommended)
              </h3>
              <div class="bg-gray-950 p-4 rounded-lg font-mono text-xs text-gray-300 border border-white/10 overflow-x-auto">
                <pre>version: '3.8'

services:
  solidb:
    image: ghcr.io/solisoft/solidb:latest
    ports:
      - "6745:6745"
    volumes:
      - solidb-data:/data
    environment:
      - SOLIDB_PORT=6745
      - RUST_LOG=solidb=info
    restart: unless-stopped

volumes:
  solidb-data:</pre>
              </div>
            </div>

            <!-- Environment Variables -->
            <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
              <h3 class="text-cyan-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Environment Variables
              </h3>
              <div class="overflow-hidden border border-white/5 rounded-lg">
                <table class="w-full text-left text-xs">
                  <thead class="bg-white/5 text-gray-300 font-bold border-b border-white/5">
                    <tr>
                      <th class="p-3">Variable</th>
                      <th class="p-3">Default</th>
                      <th class="p-3">Description</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-400 divide-y divide-white/5">
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLIDB_PORT</td>
                      <td class="p-3">6745</td>
                      <td class="p-3">HTTP server port. The image's command turns it into <code>--port</code>; the <code>solidb</code> binary itself does not read it.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLIDB_DATA_DIR</td>
                      <td class="p-3">/data</td>
                      <td class="p-3">Data directory path</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">RUST_LOG</td>
                      <td class="p-3">solidb=info,tower_http=info</td>
                      <td class="p-3">Log filter, in <code>tracing</code> directive syntax (e.g. <code>solidb=debug</code>)</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLIDB_ADMIN_PASSWORD</td>
                      <td class="p-3"><em>auto-generated</em></td>
                      <td class="p-3">Password of the <code>admin</code> user created on first start. Unset: a random one is written to <code>&lt;data-dir&gt;/.admin_password</code>.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">JWT_SECRET</td>
                      <td class="p-3"><em>auto-generated</em></td>
                      <td class="p-3">Secret for signing JWT tokens</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLI_WEBHOOK_SECRET</td>
                      <td class="p-3"><em>unset</em></td>
                      <td class="p-3">Instance-wide HMAC-SHA256 key for outbound trigger webhooks (<code>X-Webhook-Signature</code>), used only when <code>SOLIDB_ALLOW_GLOBAL_WEBHOOK_SECRET=1</code> and the trigger has no <code>webhook_secret</code>. Off by default: the target URL is tenant-chosen, so the instance secret would become a signing oracle. Without either, webhooks are sent unsigned. See <a href="/docs/triggers" class="text-cyan-400 hover:underline">Triggers</a>.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLI_JOBS_SECRET</td>
                      <td class="p-3"><em>unset</em></td>
                      <td class="p-3">Legacy fallback used only when <code>SOLI_WEBHOOK_SECRET</code> is unset, under the same <code>SOLIDB_ALLOW_GLOBAL_WEBHOOK_SECRET=1</code> condition. Prefer a per-trigger <code>webhook_secret</code>.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLIDB_NO_LUA</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Set to <code>1</code> to start no Lua VMs (same as <code>--no-lua</code>). Scripts, services and the REPL answer 501.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLIDB_LUA_POOL_SIZE</td>
                      <td class="p-3"><em>CPU cores</em></td>
                      <td class="p-3">Number of Lua VM pool states</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLIDB_LUA_FAST_MODE</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Skip the Lua global reset between requests. Ignored unless <code>SOLIDB_LUA_FAST_MODE_UNSAFE=1</code> is also set.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-cyan-400">SOLIDB_CLUSTER_SCHEME</td>
                      <td class="p-3">http</td>
                      <td class="p-3">Protocol for inter-node calls (anything but <code>http</code> means <code>https</code>; the default is <code>https</code> on a node run with <code>--tls-cert</code> and <code>SOLIDB_TLS_REQUIRE=1</code>)</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Build from Source -->
            <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
              <h3 class="text-cyan-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Build Image Locally
              </h3>
              <div class="bg-gray-950 p-4 rounded-lg font-mono text-sm text-gray-300 border border-white/10 space-y-2">
                <div class="flex">
                  <span class="text-cyan-400 mr-2">$</span>
                  <span>git clone https://github.com/solisoft/solidb</span>
                </div>
                <div class="flex">
                  <span class="text-cyan-400 mr-2">$</span>
                  <span>cd solidb</span>
                </div>
                <div class="flex">
                  <span class="text-cyan-400 mr-2">$</span>
                  <span>docker build -t ghcr.io/solisoft/solidb:latest .</span>
                </div>
              </div>
            </div>

            <!-- Health Check Info -->
            <div class="bg-green-900/10 border border-green-500/20 rounded-xl p-4">
              <p class="text-sm text-green-300">
                <strong>Health Check:</strong> The Docker image includes a built-in health check at
                <code class="text-green-400">/_api/health</code>. Container orchestrators can use this to monitor instance health.
              </p>
            </div>

            <!-- Docker Cluster -->
            <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
              <h3 class="text-cyan-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Docker Cluster Setup
              </h3>
              <p class="text-gray-300 text-sm mb-4">
                For high availability, use the cluster compose file to run multiple nodes.
              </p>
              <div class="bg-gray-950 p-4 rounded-lg font-mono text-sm text-gray-300 border border-white/10 space-y-2">
                <div class="flex">
                  <span class="text-gray-500 mr-2">#</span>
                  <span class="text-gray-500">Generate shared keyfile for cluster auth</span>
                </div>
                <div class="flex">
                  <span class="text-cyan-400 mr-2">$</span>
                  <span>openssl rand -hex 32 > solidb.key</span>
                </div>
                <div class="flex mt-2">
                  <span class="text-gray-500 mr-2">#</span>
                  <span class="text-gray-500">Required: compose refuses to start without these</span>
                </div>
                <div class="flex">
                  <span class="text-cyan-400 mr-2">$</span>
                  <span>export SOLIDB_ADMIN_PASSWORD=... JWT_SECRET=$(openssl rand -hex 32) SOLIDB_METRICS_TOKEN=$(openssl rand -hex 32)</span>
                </div>
                <div class="flex mt-2">
                  <span class="text-gray-500 mr-2">#</span>
                  <span class="text-gray-500">Start 3-node cluster</span>
                </div>
                <div class="flex">
                  <span class="text-cyan-400 mr-2">$</span>
                  <span>docker-compose -f docker-compose-cluster.yml up -d</span>
                </div>
              </div>
              <div class="mt-4 grid grid-cols-3 gap-3 text-center text-xs">
                <div class="bg-gray-950/50 p-3 rounded border border-white/5">
                  <div class="text-cyan-400 font-bold">Node 1</div>
                  <div class="text-gray-500">localhost:6745</div>
                </div>
                <div class="bg-gray-950/50 p-3 rounded border border-white/5">
                  <div class="text-cyan-400 font-bold">Node 2</div>
                  <div class="text-gray-500">localhost:6746</div>
                </div>
                <div class="bg-gray-950/50 p-3 rounded border border-white/5">
                  <div class="text-cyan-400 font-bold">Node 3</div>
                  <div class="text-gray-500">localhost:6747</div>
                </div>
              </div>
              <p class="text-gray-400 text-xs mt-4">
                Every node needs the same <code>JWT_SECRET</code>, or a token issued by one node is rejected by the others. Each node names its peers with one <code>--peer</code> flag per peer. <code>/metrics</code> answers <code>401</code> unless the scraper sends <code>Authorization: Bearer $SOLIDB_METRICS_TOKEN</code>.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Kubernetes Section -->
      <section id="kubernetes" class="scroll-mt-24">
        <div
          class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl"
        >
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg
                class="w-6 h-6 mr-3 text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                ></path>
              </svg>
              Kubernetes Deployment
            </h2>
          </div>

          <div class="p-8 space-y-8">
            <p class="text-gray-300 leading-relaxed">
              Deploy SoliDB on Kubernetes using the provided manifests for single-node or cluster deployments.
            </p>

            <!-- Single Node K8s -->
            <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
              <h3 class="text-blue-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Single Node Deployment
              </h3>
              <div class="bg-gray-950 p-4 rounded-lg font-mono text-xs text-gray-300 border border-white/10 overflow-x-auto">
                <pre><span class="text-gray-500"># Apply manifests (first replace the jwt-secret and metrics-token</span>
<span class="text-gray-500"># placeholders in k8s/secret.yaml)</span>
kubectl apply -f k8s/namespace.yaml
kubectl apply -f k8s/configmap.yaml
kubectl apply -f k8s/secret.yaml
kubectl apply -f k8s/single/

<span class="text-gray-500"># Verify deployment</span>
kubectl -n solidb get pods
kubectl -n solidb port-forward svc/solidb 6745:6745</pre>
              </div>
            </div>

            <!-- Cluster K8s -->
            <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
              <h3 class="text-blue-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Cluster Deployment (StatefulSet)
              </h3>
              <p class="text-gray-400 text-sm mb-4">
                Uses StatefulSet with headless service for automatic peer discovery via DNS.
              </p>
              <div class="bg-gray-950 p-4 rounded-lg font-mono text-xs text-gray-300 border border-white/10 overflow-x-auto">
                <pre><span class="text-gray-500"># Generate keyfile for cluster auth</span>
openssl rand -hex 32 > keyfile.txt

<span class="text-gray-500"># Create the secret: keyfile, a JWT secret shared by every pod,</span>
<span class="text-gray-500"># and the bearer token Prometheus presents on /metrics (all required)</span>
kubectl create namespace solidb
kubectl create secret generic solidb-secret -n solidb \
  --from-file=keyfile=keyfile.txt \
  --from-literal=jwt-secret="$(openssl rand -hex 32)" \
  --from-literal=metrics-token="$(openssl rand -hex 32)"

<span class="text-gray-500"># Deploy 3-node cluster</span>
kubectl apply -f k8s/configmap.yaml
kubectl apply -f k8s/cluster/

<span class="text-gray-500"># Watch pods come up</span>
kubectl -n solidb get pods -w</pre>
              </div>
            </div>

            <!-- Architecture Diagram -->
            <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
              <h3 class="text-blue-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Cluster Architecture
              </h3>
              <div class="grid grid-cols-3 gap-4 mb-4">
                <div class="bg-gray-950/50 p-4 rounded border border-blue-500/30 text-center">
                  <div class="text-blue-400 font-bold text-sm">solidb-0</div>
                  <div class="text-gray-500 text-xs mt-1">PVC: data-solidb-0</div>
                </div>
                <div class="bg-gray-950/50 p-4 rounded border border-blue-500/30 text-center">
                  <div class="text-blue-400 font-bold text-sm">solidb-1</div>
                  <div class="text-gray-500 text-xs mt-1">PVC: data-solidb-1</div>
                </div>
                <div class="bg-gray-950/50 p-4 rounded border border-blue-500/30 text-center">
                  <div class="text-blue-400 font-bold text-sm">solidb-2</div>
                  <div class="text-gray-500 text-xs mt-1">PVC: data-solidb-2</div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-gray-950/50 p-3 rounded border border-white/10 text-center">
                  <div class="text-white font-bold text-xs">solidb (ClusterIP)</div>
                  <div class="text-gray-500 text-xs">Client connections</div>
                </div>
                <div class="bg-gray-950/50 p-3 rounded border border-white/10 text-center">
                  <div class="text-white font-bold text-xs">solidb-headless</div>
                  <div class="text-gray-500 text-xs">Peer DNS discovery</div>
                </div>
              </div>
            </div>

            <!-- Features -->
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-blue-900/10 border border-blue-500/20 rounded-lg p-4">
                <h4 class="text-blue-400 font-bold text-xs uppercase mb-2">Included Features</h4>
                <ul class="text-sm text-gray-300 space-y-1">
                  <li>• Liveness & readiness probes</li>
                  <li>• Prometheus annotations (the scrape job must send the <code>metrics-token</code>)</li>
                  <li>• Pod anti-affinity</li>
                  <li>• PodDisruptionBudget</li>
                </ul>
              </div>
              <div class="bg-green-900/10 border border-green-500/20 rounded-lg p-4">
                <h4 class="text-green-400 font-bold text-xs uppercase mb-2">Scaling</h4>
                <div class="text-sm text-gray-300">
                  <code class="text-green-400 text-xs">kubectl -n solidb scale statefulset solidb --replicas=5</code>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Basic Usage Section -->
      <section id="basic-usage" class="scroll-mt-24">
        <div
          class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl"
        >
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg
                class="w-6 h-6 mr-3 text-green-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              Basic Usage
            </h2>
          </div>

          <div class="p-8 space-y-8">
            <p class="text-gray-300 leading-relaxed">
              Start the server and interact with the HTTP API using curl or your
              preferred client.
            </p>

            <div class="space-y-6">
              <!-- Step 1 -->
              <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
                <h3
                  class="text-green-400 font-bold mb-3 text-sm uppercase tracking-wider"
                >
                  1. Start Server
                </h3>
                <div
                  class="bg-gray-950 p-4 rounded-lg font-mono text-sm text-gray-300 border border-white/10 mb-3"
                >
                  ./target/release/solidb
                </div>
                <div class="flex items-start bg-blue-900/20 border border-blue-500/20 rounded-lg p-3">
                  <svg
                    class="w-5 h-5 text-blue-400 mt-0.5 mr-3 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                  <p class="text-sm text-blue-200">
                    Check the terminal output for the generated
                    <strong class="text-white">admin</strong> password. You will
                    need it to authenticate.
                  </p>
                </div>
              </div>

              <!-- Step 2 -->
              <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
                <h3
                  class="text-green-400 font-bold mb-3 text-sm uppercase tracking-wider"
                >
                  2. Create Database
                </h3>
                <div
                  class="bg-gray-950 p-4 rounded-lg font-mono text-sm text-gray-300 border border-white/10 mb-3"
                >
                  curl -X POST http://localhost:8080/_api/database -d '{"name":
                  "mydb"}'
                </div>
                <p class="text-xs text-gray-500">
                  Creates a new database namespace called "mydb".
                </p>
              </div>

              <!-- Step 3 -->
              <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
                <h3
                  class="text-green-400 font-bold mb-3 text-sm uppercase tracking-wider"
                >
                  3. Insert Document
                </h3>
                <div
                  class="bg-gray-950 p-4 rounded-lg font-mono text-sm text-gray-300 border border-white/10 mb-3"
                >
                  curl -X POST http://localhost:8080/_api/document/mydb/users
                  \<br />
                  &nbsp;&nbsp;-d '{"name": "Alice", "age": 30, "city": "Paris"}'
                </div>
                <p class="text-xs text-gray-500">
                  Inserts a JSON document into the "users" collection within
                  "mydb".
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Admin UI Section -->
      <section id="admin-ui" class="scroll-mt-24">
        <div
          class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl"
        >
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg
                class="w-6 h-6 mr-3 text-purple-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"
                ></path>
              </svg>
              Admin UI
            </h2>
          </div>

          <div class="p-8 space-y-6">
            <p class="text-gray-300 leading-relaxed">
              SoliDB ships a web-based admin console, the Soli app in the <code class="text-purple-400">admin/</code> directory of the repository, for managing databases, collections, documents, scripts and running queries.
            </p>

            <div class="bg-gray-800/30 rounded-xl p-6 border border-white/5">
              <h3
                class="text-purple-400 font-bold mb-3 text-sm uppercase tracking-wider"
              >
                Launch Admin UI
              </h3>
              <div
                class="bg-gray-950 p-4 rounded-lg font-mono text-sm text-gray-300 border border-white/10 mb-3"
              >
                <div class="flex">
                  <span class="text-purple-400 mr-2">$</span
                  ><span class="text-gray-300">cd admin</span>
                </div>
                <div class="flex">
                  <span class="text-purple-400 mr-2">$</span
                  ><span class="text-gray-300">soli serve . --dev</span>
                </div>
              </div>
              <p class="text-sm text-gray-400">
                The dev server prints the URL it listens on. Copy <code class="text-purple-400">admin/.env.example</code> to <code class="text-purple-400">admin/.env</code> first and set <code class="text-purple-400">ADMIN_UI_PASSWORD</code>: the console holds an admin credential for SoliDB and refuses to serve without a login unless you explicitly set <code class="text-purple-400">ADMIN_UI_ALLOW_NO_AUTH</code>.
              </p>
            </div>

            <div class="bg-purple-900/10 border border-purple-500/20 rounded-lg p-4">
              <p class="text-sm text-purple-200">
                <strong>Note:</strong> The admin console requires SoliDB to be running on port 6745 (or at the URL configured in <code>admin/.env</code>).
                See <code>admin/CLAUDE.md</code> in the repository for the full list of settings.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Configuration Section -->
      <section id="configuration" class="scroll-mt-24">
        <div
          class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl"
        >
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg
                class="w-6 h-6 mr-3 text-amber-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                ></path>
              </svg>
              Configuration
            </h2>
          </div>
          <div class="p-8 space-y-6">
            <p class="text-gray-300 leading-relaxed">
              SoliDB can be configured using command-line arguments, environment
              variables, or an <code class="text-amber-400">.env</code> file
              located in the same directory as the executable.
            </p>

            <!-- Security -->
            <div class="bg-amber-900/10 border border-amber-500/20 rounded-xl p-6">
              <h3 class="text-amber-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Security
              </h3>
              <div class="overflow-hidden border border-white/5 rounded-lg">
                <table class="w-full text-left text-xs">
                  <thead class="bg-white/5 text-gray-300 font-bold border-b border-white/5">
                    <tr>
                      <th class="p-3">Variable</th>
                      <th class="p-3">Default</th>
                      <th class="p-3">Description</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-400 divide-y divide-white/5">
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_ADMIN_PASSWORD</td>
                      <td class="p-3"><em>auto-generated</em></td>
                      <td class="p-3">Password for the <code class="text-amber-400">admin</code> user created on first start (when no admin exists yet); it does not change an existing admin. If unset, a random password is written to <code class="text-amber-400">&lt;data-dir&gt;/.admin_password</code> (mode 0600) and the log gives that path. A node started with <code class="text-amber-400">--peer</code> creates no admin unless this is set: it expects to receive one from the cluster.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">JWT_SECRET</td>
                      <td class="p-3"><em>auto-generated</em></td>
                      <td class="p-3">Secret key for signing JSON Web Tokens. 32+ characters recommended. If not set, a random secret is generated (warning logged).</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_API_RATE_LIMIT</td>
                      <td class="p-3">0 (off)</td>
                      <td class="p-3">Requests allowed per caller per window across the whole API: per credential when the request carries one, otherwise per client address. Over the limit the server answers <code class="text-amber-400">429</code> with <code class="text-amber-400">Retry-After</code>. Off by default, because a database usually sits behind an application tier it trusts; turn it on for a node exposed to untrusted clients. Internal cluster traffic and CORS preflights are always exempt.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_API_RATE_WINDOW_SECS</td>
                      <td class="p-3">60</td>
                      <td class="p-3">Length of the rate-limit window in seconds.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_API_RATE_LIMIT_PER_IP</td>
                      <td class="p-3">10 &times; <code>SOLIDB_API_RATE_LIMIT</code></td>
                      <td class="p-3">Budget per client address, applied on top of the per-credential limit so that minting a new credential per request does not escape it. Set it only to change the 10&times; margin.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_DB_AUTHZ_MODE</td>
                      <td class="p-3">enforce</td>
                      <td class="p-3"><code class="text-amber-400">warn</code> logs per-database authorization failures instead of refusing them, as a dry run before enforcing. Ignored (and logged as an error) unless <code class="text-amber-400">SOLIDB_DB_AUTHZ_ALLOW_WARN=1</code> is also set.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_DB_AUTHZ_ALLOW_WARN</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Confirms <code class="text-amber-400">SOLIDB_DB_AUTHZ_MODE=warn</code>. Accepts <code class="text-amber-400">1</code> or <code class="text-amber-400">true</code>.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_ALLOW_UNAUTHENTICATED_SYNC</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Accept replication connections that do not authenticate with the keyfile. <code class="text-amber-400">SOLIDB_REQUIRE_KEYFILE=true</code> overrides it. Leave it off outside a test bench.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_ENABLE_AI_VALIDATION</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Enables the AI validation endpoints (<code class="text-amber-400">/_api/ai/validate</code>…), which run <code class="text-amber-400">cargo</code> on the server host. They also require a global admin. Development hosts only.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_ALLOW_WEBHOOK_LOOPBACK</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Let trigger webhooks target loopback addresses (<code class="text-amber-400">127.0.0.1</code>, <code class="text-amber-400">::1</code>, <code class="text-amber-400">localhost</code>). Development only.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_ALLOW_INSECURE_WEBHOOK_TLS</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Skip certificate verification for webhooks to development hosts only (<code class="text-amber-400">localhost</code>, <code class="text-amber-400">*.localhost</code>, <code class="text-amber-400">*.test</code>, <code class="text-amber-400">*.local</code>). Every other host keeps full TLS checks.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_TRUST_PROXY_HEADERS</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Key rate limits on <code class="text-amber-400">X-Forwarded-For</code> / <code class="text-amber-400">X-Real-IP</code> instead of the socket peer. Set this only behind a proxy that <em>overwrites</em> those headers &mdash; otherwise any client can spoof its own identity and evade the limiter.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_TLS_REQUIRE</td>
                      <td class="p-3">false</td>
                      <td class="p-3">With <code class="text-amber-400">--tls-cert</code> set, drop any connection on the multiplexed port that does not offer TLS. Leave it off on a node that serves native driver clients or has cluster peers &mdash; neither speaks TLS. See <a href="/docs/security#tls" class="text-cyan-400 hover:underline">Transport Security</a>.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_METRICS_TOKEN</td>
                      <td class="p-3"><em>unset</em></td>
                      <td class="p-3">Bearer token (<code class="text-amber-400">Authorization: Bearer</code> or <code class="text-amber-400">X-Metrics-Token</code>) that authorizes scrapes of <code class="text-amber-400">/metrics</code>. Without it only an admin JWT is accepted, and <code class="text-amber-400">/metrics</code> answers <code class="text-amber-400">401</code> to Prometheus. <code class="text-amber-400">SOLIDB_METRICS_PUBLIC=1</code> removes the check.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_PASSWORD</td>
                      <td class="p-3"><em>unset</em></td>
                      <td class="p-3">Password read by <code class="text-amber-400">solidb-dump</code>, <code class="text-amber-400">solidb-restore</code> and <code class="text-amber-400">solidb-fuse</code> when neither <code class="text-amber-400">-p</code> nor <code class="text-amber-400">--password-file</code> is given (dump and restore read it only together with <code class="text-amber-400">-u</code>). Keeps the password out of <code class="text-amber-400">ps</code> and shell history.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Performance Tuning -->
            <div class="bg-cyan-900/10 border border-cyan-500/20 rounded-xl p-6">
              <h3 class="text-cyan-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Performance Tuning
              </h3>
              <div class="overflow-hidden border border-white/5 rounded-lg">
                <table class="w-full text-left text-xs">
                  <thead class="bg-white/5 text-gray-300 font-bold border-b border-white/5">
                    <tr>
                      <th class="p-3">Variable</th>
                      <th class="p-3">Default</th>
                      <th class="p-3">Description</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-400 divide-y divide-white/5">
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_MAX_INTERMEDIATE_ROWS</td>
                      <td class="p-3">5000000</td>
                      <td class="p-3">Rows a single query may materialise, checked inside the executor. It bounds nested <code class="text-amber-400">FOR</code> cartesian products, which no <code class="text-amber-400">LIMIT</code> reaches. A query over the limit fails; the server keeps running. Invalid or <code class="text-amber-400">0</code> falls back to the default.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_GZIP_MIN_BYTES</td>
                      <td class="p-3">4096</td>
                      <td class="p-3">Smallest response body that gets gzip-compressed. Below that the saving is under one packet while the CPU cost is the same.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_NO_LUA</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Set to <code class="text-amber-400">1</code>, <code class="text-amber-400">true</code> or <code class="text-amber-400">yes</code> (or start with <code class="text-amber-400">--no-lua</code>) to create no Lua VM pool. Custom scripts, <code class="text-amber-400">/api/&#123;db&#125;/&#123;service&#125;/&hellip;</code> and the Lua REPL answer <code class="text-amber-400">501</code>; a trigger whose action is a Lua script fails its job at once, without retries. Script documents can still be stored. For nodes that never run Lua: it saves the pool's idle memory, about 150 KB per state (2.5 MB measured with 16 states).</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_LUA_POOL_SIZE</td>
                      <td class="p-3"><em>CPU cores</em> (min 4)</td>
                      <td class="p-3">Number of pre-initialized Lua VM states in the pool. Each state handles one script at a time. Increase beyond CPU core count (e.g. 32 or 64) to reduce contention under high concurrency.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_LUA_FAST_MODE</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Skip the Lua global reset between requests. <strong>Ignored</strong> (with a warning) unless <code class="text-amber-400">SOLIDB_LUA_FAST_MODE_UNSAFE=1</code> is also set, because globals one request sets then stay visible to later requests, possibly other users&rsquo;. Only for stateless, single-tenant scripts.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_LUA_FETCH_MAX_BYTES</td>
                      <td class="p-3">10485760 (10 MB)</td>
                      <td class="p-3">Largest response body a Lua <code class="text-amber-400">fetch</code> will read.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_LUA_RATE_LIMIT_MAX_KEYS</td>
                      <td class="p-3">100000</td>
                      <td class="p-3">Most buckets <code class="text-amber-400">solidb.rate_limit</code> keeps in memory.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_REPL_MAX_SESSIONS_PER_USER</td>
                      <td class="p-3">8</td>
                      <td class="p-3">Lua REPL sessions one user may hold.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_REPL_MAX_SESSIONS</td>
                      <td class="p-3">1000</td>
                      <td class="p-3">Lua REPL sessions across the instance.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_STREAM_MAX_BUFFER_EVENTS</td>
                      <td class="p-3">100000</td>
                      <td class="p-3">Events one stream window may buffer; the oldest are dropped with a warning past it.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_STREAM_MAX_BUFFER_BYTES</td>
                      <td class="p-3">67108864 (64 MiB)</td>
                      <td class="p-3">Bytes one stream window may buffer.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_QUEUE_MAX_CONCURRENCY</td>
                      <td class="p-3">4 &times; CPU cores</td>
                      <td class="p-3">Queue jobs executing at once, across all databases.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_JOBS_RETENTION_SECS</td>
                      <td class="p-3">604800 (7 days)</td>
                      <td class="p-3">How long completed and failed <code class="text-amber-400">_jobs</code> rows are kept. <code class="text-amber-400">0</code> keeps them forever. Rows written by the Soli framework (which use <code class="text-amber-400">state</code>) are not touched.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_JOBS_LEASE_SECS</td>
                      <td class="p-3">max(600, 2 &times; Lua timeout)</td>
                      <td class="p-3">A job left <code class="text-amber-400">running</code> longer than this is presumed orphaned and requeued (counts as a retry). Minimum 60.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SEMANTIC_CACHE_ENABLED</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Cache responses of <code class="text-amber-400">POST /_api/database/&#123;db&#125;/ai/generate</code> and answer a later prompt from the cache when its embedding is close enough. Entries are kept per database and per user. Accepts <code class="text-amber-400">1</code>, <code class="text-amber-400">true</code>, <code class="text-amber-400">yes</code>, <code class="text-amber-400">on</code>.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SEMANTIC_CACHE_THRESHOLD</td>
                      <td class="p-3">0.95</td>
                      <td class="p-3">Cosine similarity a new prompt must reach to reuse a cached response.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SEMANTIC_CACHE_TTL</td>
                      <td class="p-3">3600</td>
                      <td class="p-3">Seconds a cached response stays valid.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SEMANTIC_CACHE_MAX</td>
                      <td class="p-3">256</td>
                      <td class="p-3">Cached responses kept per database and user.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SEMANTIC_CACHE_PROVIDER</td>
                      <td class="p-3">openai</td>
                      <td class="p-3">Provider used to embed prompts for the cache (<code class="text-amber-400">openai</code>, <code class="text-amber-400">ollama</code>, <code class="text-amber-400">gemini</code>), configured like any other provider. Anthropic has no embedding model.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Storage -->
            <div class="bg-green-900/10 border border-green-500/20 rounded-xl p-6">
              <h3 class="text-green-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Storage (RocksDB)
              </h3>
              <p class="text-gray-400 text-xs mb-3">Each of the first seven also has a command-line flag of the same name (<code class="text-amber-400">--block-cache</code>, <code class="text-amber-400">--memtable-budget</code>, &hellip;); the flag wins. Sizes accept <code class="text-amber-400">512MB</code>, <code class="text-amber-400">2GB</code> or a byte count. Defaults are given as production / <code class="text-amber-400">--dev</code>.</p>
              <div class="overflow-hidden border border-white/5 rounded-lg">
                <table class="w-full text-left text-xs">
                  <thead class="bg-white/5 text-gray-300 font-bold border-b border-white/5">
                    <tr>
                      <th class="p-3">Variable</th>
                      <th class="p-3">Default</th>
                      <th class="p-3">Description</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-400 divide-y divide-white/5">
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_BLOCK_CACHE</td>
                      <td class="p-3">512MB / 128MB</td>
                      <td class="p-3">Shared RocksDB block cache.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_MEMTABLE_BUDGET</td>
                      <td class="p-3">512MB / 128MB</td>
                      <td class="p-3">Cap on total memtable memory across all collections. <code class="text-amber-400">0</code> means unlimited. This is the knob that bounds write memory.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_WRITE_BUFFER_SIZE</td>
                      <td class="p-3">64MB / 8MB</td>
                      <td class="p-3">Memtable size per column family: the shared collection family, plus any 1.x column family not yet migrated.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_MAX_OPEN_FILES</td>
                      <td class="p-3">-1 / 512</td>
                      <td class="p-3">Open SST limit; <code class="text-amber-400">-1</code> is unlimited. Each open SST pins its index and filter blocks unless <code class="text-amber-400">SOLIDB_BOUNDED_INDEX_CACHE</code> is on, so on a large dataset this caps that memory.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_BOUNDED_INDEX_CACHE</td>
                      <td class="p-3">false / true</td>
                      <td class="p-3">Keep index and filter blocks in the block cache instead of pinning them per SST. Caps their memory at some cost in read latency.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_MAX_BACKGROUND_JOBS</td>
                      <td class="p-3">6 / 2</td>
                      <td class="p-3">Background compaction and flush threads.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_MAX_TOTAL_WAL_SIZE</td>
                      <td class="p-3">2GB / 256MB</td>
                      <td class="p-3">Total WAL budget. It is a flush trigger, not a disk cap: lowering it to save disk produces many tiny SSTs. Bound memory with <code class="text-amber-400">SOLIDB_MEMTABLE_BUDGET</code> instead.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_BACKUP_ROOT</td>
                      <td class="p-3"><code>&lt;data-dir&gt;/backups</code></td>
                      <td class="p-3">Directory that <code class="text-amber-400">POST /_api/backup</code> checkpoints are written under; a requested path must stay inside it. A checkpoint hard-links SST files, so it must be on the same filesystem as the data.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_AUTO_CREATE_COLLECTIONS</td>
                      <td class="p-3">true</td>
                      <td class="p-3">Writing a document to an unknown collection creates it. Set to <code class="text-amber-400">0</code> to get <code class="text-amber-400">CollectionNotFound</code> instead.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_KS_GC_DELAY_SECS</td>
                      <td class="p-3">10</td>
                      <td class="p-3">Delay before a dropped collection's key range is compacted and its space reclaimed.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_MIGRATION_SKIP_SPACE_CHECK</td>
                      <td class="p-3">unset</td>
                      <td class="p-3">Set to <code class="text-amber-400">1</code> to start the 1.x &rarr; 2.x storage migration even when free disk is below 1.2 &times; the largest collection + 1 GiB.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_LEGACY_COLLECTION_CFS</td>
                      <td class="p-3">false</td>
                      <td class="p-3">Create new collections as 1.x column families and skip the migration. For testing the legacy path only.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_CF_REUSE_GRACE_SECS</td>
                      <td class="p-3">300</td>
                      <td class="p-3">Legacy (1.x) collections only: grace period before an emptied column family is dropped.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Cluster -->
            <div class="bg-green-900/10 border border-green-500/20 rounded-xl p-6">
              <h3 class="text-green-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Cluster & Networking
              </h3>
              <div class="overflow-hidden border border-white/5 rounded-lg">
                <table class="w-full text-left text-xs">
                  <thead class="bg-white/5 text-gray-300 font-bold border-b border-white/5">
                    <tr>
                      <th class="p-3">Variable</th>
                      <th class="p-3">Default</th>
                      <th class="p-3">Description</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-400 divide-y divide-white/5">
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_CLUSTER_SCHEME</td>
                      <td class="p-3">http</td>
                      <td class="p-3">Protocol for inter-node communication (<code class="text-amber-400">http</code> or <code class="text-amber-400">https</code>). Used for every inter-node HTTP/WebSocket URL: shard forwarding, blob sync, healing, rebalancing and scatter-gather queries. Only the literal <code class="text-amber-400">http</code> selects cleartext; any other value means <code class="text-amber-400">https</code>, so a typo cannot downgrade the cluster. Unset, it defaults to <code class="text-amber-400">https</code> on a node running with <code class="text-amber-400">--tls-cert</code> and <code class="text-amber-400">SOLIDB_TLS_REQUIRE=1</code>.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_CLUSTER_HTTP_TIMEOUT_SECS</td>
                      <td class="p-3">60</td>
                      <td class="p-3">Total timeout of one inter-node HTTP request.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_CLUSTER_HTTP_READ_TIMEOUT_SECS</td>
                      <td class="p-3">60</td>
                      <td class="p-3">Idle time allowed between reads on an inter-node response, streaming ones included, so a peer that stalls mid-transfer is detected.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_CLUSTER_STREAM_TIMEOUT_SECS</td>
                      <td class="p-3">21600 (6 h)</td>
                      <td class="p-3">Total cap for long streaming transfers such as shard copies and exports.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- CLI -->
            <div class="bg-purple-900/10 border border-purple-500/20 rounded-xl p-6">
              <h3 class="text-purple-400 font-bold mb-3 text-sm uppercase tracking-wider">
                CLI (solidb scripts)
              </h3>
              <div class="overflow-hidden border border-white/5 rounded-lg">
                <table class="w-full text-left text-xs">
                  <thead class="bg-white/5 text-gray-300 font-bold border-b border-white/5">
                    <tr>
                      <th class="p-3">Variable</th>
                      <th class="p-3">Default</th>
                      <th class="p-3">Description</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-400 divide-y divide-white/5">
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_API_KEY</td>
                      <td class="p-3"><em>none</em></td>
                      <td class="p-3">API key for CLI authentication. Overrides the <code class="text-amber-400">auth_token</code> that <code class="text-amber-400">solidb scripts login</code> saves in <code class="text-amber-400">solidb-scripts.toml</code>.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_HOST</td>
                      <td class="p-3"><em>none</em></td>
                      <td class="p-3">Server hostname for CLI commands. Overrides config file. <strong>The server reads it too</strong>: it is the bind address when <code class="text-amber-400">--host</code> is not given (default <code class="text-amber-400">127.0.0.1</code>), so exporting it for the CLI also moves a server started from the same shell.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_PORT</td>
                      <td class="p-3"><em>none</em></td>
                      <td class="p-3">Server port for CLI commands. Overrides config file.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_DATABASE</td>
                      <td class="p-3"><em>none</em></td>
                      <td class="p-3">Target database for CLI commands. Overrides config file.</td>
                    </tr>
                    <tr>
                      <td class="p-3 font-mono text-indigo-400">SOLIDB_SERVICE</td>
                      <td class="p-3">default</td>
                      <td class="p-3">Default service name for script API routing.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="group">
              <h3 class="text-lg font-semibold text-white mb-3">Example .env</h3>
              <div
                class="bg-gray-950 p-4 rounded-xl border border-white/10 font-mono text-sm text-gray-300 whitespace-pre"
              >SOLIDB_ADMIN_PASSWORD=my_secure_password
JWT_SECRET=your-secure-jwt-secret-32-chars-min
SOLIDB_LUA_POOL_SIZE=32
SOLIDB_CLUSTER_SCHEME=https
SOLIDB_API_RATE_LIMIT=600
SOLIDB_API_RATE_WINDOW_SECS=60</div>
            </div>

            <div class="bg-emerald-900/10 border border-emerald-500/20 rounded-xl p-6 mt-6">
              <h3 class="text-emerald-400 font-bold mb-3 text-sm uppercase tracking-wider">
                HTTPS (TLS certificates)
              </h3>
              <p class="text-gray-300 text-sm mb-4">
                TLS is configured with command-line flags rather than environment variables, and both are required together &mdash; one without the other refuses to start rather than silently listening in plaintext.
              </p>
              <div class="space-y-3">
                <div class="bg-gray-950 p-3 rounded-lg font-mono text-sm text-gray-300 border border-white/10">
                  <span class="text-gray-500"># Terminate TLS in the server (rustls, no OpenSSL)</span><br/>
                  ./solidb --port 6745 --data-dir ./data --tls-cert fullchain.pem --tls-key privkey.pem
                </div>
              </div>
              <p class="text-gray-400 text-xs mt-3">
                On a multiplexed port the listener only handshakes with clients that offer TLS, so plaintext driver and cluster peers keep working alongside HTTPS clients. See <a href="/docs/security#tls" class="text-cyan-400 hover:underline">Transport Security</a>.
              </p>
            </div>

            <div class="bg-blue-900/10 border border-blue-500/20 rounded-xl p-6 mt-6">
              <h3 class="text-blue-400 font-bold mb-3 text-sm uppercase tracking-wider">
                Cluster Authentication (Keyfile)
              </h3>
              <p class="text-gray-300 text-sm mb-4">
                For cluster mode, inter-node authentication uses a shared keyfile instead of environment variables.
                All nodes must use the same keyfile content.
              </p>
              <div class="space-y-3">
                <div class="bg-gray-950 p-3 rounded-lg font-mono text-sm text-gray-300 border border-white/10">
                  <span class="text-gray-500"># Generate a keyfile</span><br/>
                  openssl rand -hex 32 > solidb.key
                </div>
                <div class="bg-gray-950 p-3 rounded-lg font-mono text-sm text-gray-300 border border-white/10">
                  <span class="text-gray-500"># Start with keyfile</span><br/>
                  ./solidb --keyfile solidb.key --peer node2:6746 --peer node3:6746
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Next Steps -->
      <section id="next-steps" class="scroll-mt-24">
