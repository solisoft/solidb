<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <a href="/docs/sdbql" class="inline-flex items-center text-indigo-400 hover:text-indigo-300 font-medium transition-colors group">
      <svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to SDBQL Reference
    </a>
  </div>

  <div class="lg:grid lg:grid-cols-12 lg:gap-12">
    <main class="lg:col-span-12 space-y-12">
      <!-- Header -->
      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-orange-500 to-amber-600 rounded-lg blur opacity-25"></div>
        <div class="relative">
          <h1 class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-400 to-yellow-400 mb-4 tracking-tight">
            Aggregations
          </h1>
          <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
            COLLECT for grouping, AGGREGATE for computing SUM, AVG, COUNT, MIN, MAX and statistical functions.
          </p>
        </div>
      </div>

      <!-- Group & Aggregate -->
      <section id="group-aggregate" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-gradient-to-r from-orange-500/10 to-amber-500/10">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              Group & Aggregate
            </h2>
          </div>
          <div class="p-8 space-y-8">
            <p class="text-gray-300 leading-relaxed">
              Use the <code>COLLECT</code> clause to group documents and perform aggregations like counting, summing, or averaging.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Basic Grouping -->
              <div class="bg-gray-800/30 rounded-xl border border-white/5 overflow-hidden">
                <div class="p-5 border-b border-white/5 bg-white/5">
                  <h3 class="text-lg font-bold text-orange-300 flex items-center">Basic Grouping</h3>
                </div>
                <div class="p-5 space-y-4">
                  <p class="text-sm text-gray-400">Group results by one or more fields to find distinct values.</p>
                  <pre><code class="language-sql text-sm">FOR doc IN users
  COLLECT city = doc.city
  RETURN { city }</code></pre>
                </div>
              </div>

              <!-- With COUNT -->
              <div class="bg-gray-800/30 rounded-xl border border-white/5 overflow-hidden">
                <div class="p-5 border-b border-white/5 bg-white/5">
                  <h3 class="text-lg font-bold text-orange-300 flex items-center">Counting Groups</h3>
                </div>
                <div class="p-5 space-y-4">
                  <p class="text-sm text-gray-400">Count the number of items in each group using <code>WITH COUNT INTO</code>.</p>
                  <pre><code class="language-sql text-sm">FOR doc IN users
  COLLECT city = doc.city
  WITH COUNT INTO count
  RETURN { city, count }</code></pre>
                </div>
              </div>
            </div>

            <!-- With Aggregation -->
            <div class="bg-gray-800/30 rounded-xl border border-white/5 overflow-hidden">
              <div class="p-5 border-b border-white/5 bg-white/5">
                <h3 class="text-lg font-bold text-orange-300 flex items-center">Aggregation Functions</h3>
              </div>
              <div class="p-5 space-y-4">
                <p class="text-sm text-gray-400">Calculate aggregates using functions like <code>SUM</code>, <code>AVG</code>, <code>MIN</code>, <code>MAX</code>.</p>
                <pre><code class="language-sql text-sm">FOR s IN sales
  COLLECT product = s.product
  AGGREGATE
    total = SUM(s.amount),
    average = AVG(s.amount),
    min_amt = MIN(s.amount),
    max_amt = MAX(s.amount)
  RETURN { product, total, average, min_amt, max_amt }</code></pre>
              </div>
            </div>

            <!-- Collecting Lists -->
            <div class="bg-gray-800/30 rounded-xl border border-white/5 overflow-hidden">
              <div class="p-5 border-b border-white/5 bg-white/5">
                <h3 class="text-lg font-bold text-orange-300 flex items-center">Collecting Lists</h3>
              </div>
              <div class="p-5 space-y-4">
                <p class="text-sm text-gray-400">Use <code>COLLECT_LIST</code> to aggregate values from the group into an array.</p>
                <pre><code class="language-sql text-sm">FOR u IN users
  COLLECT city = u.city
  AGGREGATE userNames = COLLECT_LIST(u.name)
  RETURN {
    city,
    userNames
  }</code></pre>
              </div>
            </div>

            <!-- KEEP restriction -->
            <div class="bg-gray-800/30 rounded-xl border border-white/5 overflow-hidden">
              <div class="p-5 border-b border-white/5 bg-white/5">
                <h3 class="text-lg font-bold text-orange-300 flex items-center">Restricting Group Items with KEEP</h3>
              </div>
              <div class="p-5 space-y-4">
                <p class="text-sm text-gray-400">
                  With <code>INTO groups</code>, each group array normally stores every variable in
                  scope. Add <code class="text-orange-300">KEEP v1, v2</code> to store only those
                  variables — smaller results, no leaked document bodies.
                </p>
                <pre><code class="language-sql text-sm">FOR u IN users
  LET n = u.name
  COLLECT city = u.city INTO g KEEP n
  RETURN { city, names: g[*].n }</code></pre>
                <p class="text-xs text-gray-500">
                  Without <code>KEEP</code>, each item of <code>g</code> would also carry <code>u</code>.
                  Every name listed must be a variable in scope at the <code>COLLECT</code> — an
                  unknown name is an error, not an empty group item.
                </p>
              </div>
            </div>

            <!-- AGGREGATE reference -->
            <div class="bg-gray-800/30 rounded-xl border border-white/5 overflow-hidden">
              <div class="p-5 border-b border-white/5 bg-white/5">
                <h3 class="text-lg font-bold text-orange-300 flex items-center">Functions Available in AGGREGATE</h3>
              </div>
              <div class="p-5 space-y-4 overflow-x-auto">
                <table class="w-full text-sm">
                  <tbody>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">COUNT()</td><td class="py-2 text-gray-400">Number of rows in the group.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">COUNT(expr)</td><td class="py-2 text-gray-400">Rows where <code>expr</code> is not null.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">LENGTH(expr)</td><td class="py-2 text-gray-400">Number of rows (AQL: same as <code>COUNT()</code>).</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">SUM(expr)</td><td class="py-2 text-gray-400">Sum of the numeric values; other values are skipped.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">AVG(expr) / AVERAGE(expr)</td><td class="py-2 text-gray-400">Mean of the numeric values; <code>null</code> when there are none.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">MIN(expr) / MINIMUM(expr), MAX(expr) / MAXIMUM(expr)</td><td class="py-2 text-gray-400">Smallest / largest non-null value in AQL type order; the stored value is returned unchanged.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">COUNT_DISTINCT(expr) / COUNT_UNIQUE(expr)</td><td class="py-2 text-gray-400">Number of distinct values (<code>1</code> and <code>1.0</code> are the same value).</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">UNIQUE(expr)</td><td class="py-2 text-gray-400">The distinct values, as an array, in first-seen order.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">SORTED_UNIQUE(expr)</td><td class="py-2 text-gray-400">The distinct values, sorted.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">COLLECT_LIST(expr) / PUSH(expr)</td><td class="py-2 text-gray-400">Every value, as an array, in row order.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">VARIANCE(expr) / VARIANCE_POPULATION(expr), VARIANCE_SAMPLE(expr)</td><td class="py-2 text-gray-400">Population / sample variance of the numeric values.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">STDDEV(expr) / STDDEV_POPULATION(expr), STDDEV_SAMPLE(expr)</td><td class="py-2 text-gray-400">Population / sample standard deviation.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">MEDIAN(expr)</td><td class="py-2 text-gray-400">Median of the numeric values.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">BIT_AND(expr), BIT_OR(expr), BIT_XOR(expr)</td><td class="py-2 text-gray-400">Bitwise fold of the integer values; nulls are skipped, any other non-integer makes the result <code>null</code>.</td></tr>
                  </tbody>
                </table>
                <p class="text-xs text-gray-500">
                  These mean the same thing whatever the collection's storage layout. <code>PERCENTILE</code> takes
                  a second argument, so it is not available in <code>AGGREGATE</code>; use
                  <code>COLLECT … INTO g</code> and <code>PERCENTILE(g[*].u.amount, 95)</code> (each item of <code>g</code> holds the loop variables).
                </p>
                <p class="text-xs text-gray-500">
                  Groups are returned in ascending order of their group values. A <code>COLLECT</code> with no
                  group variable always returns exactly one row, even over no input:
                  <code>FOR u IN [] COLLECT WITH COUNT INTO n RETURN n</code> is <code>[0]</code>.
                </p>
              </div>
            </div>

            <!-- Syntax Reference -->
            <div class="bg-gray-950/50 rounded-lg border border-white/5 p-4 mt-8">
              <code class="text-sm text-gray-300 font-mono block whitespace-pre overflow-x-auto">COLLECT <span class="text-orange-400">variable</span> = <span class="text-purple-400">expression</span> [, ...]
[INTO <span class="text-orange-400">groupVariable</span> [KEEP <span class="text-orange-400">var1</span>, <span class="text-orange-400">var2</span>, ...]]
[WITH COUNT INTO <span class="text-orange-400">countVariable</span>]
[AGGREGATE <span class="text-orange-400">variable</span> = <span class="text-blue-400">FUNC</span>(<span class="text-purple-400">expression</span>) [, ...]]</code>
            </div>
          </div>
        </div>
      </section>

      <!-- Aggregation Functions -->
      <section id="aggregation-functions" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">Aggregation Functions</h2>
          </div>
          <div class="p-8 space-y-8">
            <h4 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">Basic Aggregations</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div id="fn-SUM" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-SUM" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">SUM(arr)</code>
                <p class="text-sm text-gray-400 mb-3">Sum of all values in the array.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN SUM([1, 2, 3, 4]) --10</code></pre>
              </div>
              <div id="fn-AVG" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-AVG" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">AVG(arr)</code>
                <p class="text-sm text-gray-400 mb-3">Average of all values.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN AVG([1, 2, 3, 4]) --2.5</code></pre>
              </div>
              <div id="fn-MIN" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-MIN" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">MIN(arr)</code>
                <p class="text-sm text-gray-400 mb-3">Smallest value in the array.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN MIN([5, 1, 9]) --1</code></pre>
              </div>
              <div id="fn-MAX" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-MAX" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">MAX(arr)</code>
                <p class="text-sm text-gray-400 mb-3">Largest value in the array.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN MAX([5, 1, 9]) --9</code></pre>
              </div>
              <div id="fn-COUNT" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-COUNT" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">COUNT(arr)</code>
                <p class="text-sm text-gray-400 mb-3">Number of elements in the array.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN COUNT([1, 2, 3]) --3</code></pre>
              </div>
              <div id="fn-COUNT_DISTINCT" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-COUNT_DISTINCT" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">COUNT_DISTINCT(arr)</code>
                <p class="text-sm text-gray-400 mb-3">Number of unique elements.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN COUNT_DISTINCT([1, 2, 2, 3]) --3</code></pre>
              </div>
              <div id="fn-MEDIAN" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-MEDIAN" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">MEDIAN(arr)</code>
                <p class="text-sm text-gray-400 mb-3">Median value of the array.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN MEDIAN([1, 5, 10]) --5</code></pre>
              </div>
              <div id="fn-PERCENTILE" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-PERCENTILE" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">PERCENTILE(arr, p [, method])</code>
                <p class="text-sm text-gray-400 mb-3">Returns the p-th percentile (<code class="text-xs">p</code> in 0-100). <code class="text-xs">method</code> is <code class="text-xs">"rank"</code> (default) or <code class="text-xs">"interpolation"</code>.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN PERCENTILE([1..100], 95) --95
RETURN PERCENTILE([1, 2, 3, 4], 50, "interpolation") --2.5</code></pre>
              </div>
            </div>

            <h4 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">Statistical Functions</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div id="fn-VARIANCE" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                  <a href="#fn-VARIANCE" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-blue-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                  <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">VARIANCE(arr) / VARIANCE_POPULATION(arr)</code>
                  <p class="text-sm text-gray-400 mb-3">Population variance: 0 for one value, <code>null</code> for none.</p>
                  <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN VARIANCE([1, 2, 3, 4, 5]) --2</code></pre>
                </div>
              <div id="fn-VARIANCE_SAMPLE" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                <a href="#fn-VARIANCE_SAMPLE" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-orange-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">VARIANCE_SAMPLE(arr)</code>
                <p class="text-sm text-gray-400 mb-3">Sample variance.</p>
                <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN VARIANCE_SAMPLE([1, 2, 3, 4, 5]) --2.5</code></pre>
              </div>
                <div id="fn-STDDEV" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                  <a href="#fn-STDDEV" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-blue-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                  <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">STDDEV(arr)</code>
                  <p class="text-sm text-gray-400 mb-3"><strong>Population</strong> standard deviation, as in AQL (same as <code>STDDEV_POPULATION</code>).</p>
                  <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN STDDEV([1, 2, 3, 4, 5]) --1.414...</code></pre>
                </div>
                <div id="fn-STDDEV_POPULATION" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                  <a href="#fn-STDDEV_POPULATION" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-blue-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                  <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">STDDEV_POPULATION(arr)</code>
                  <p class="text-sm text-gray-400 mb-3">Population standard deviation.</p>
                  <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN STDDEV_POPULATION([1, 2, 3, 4, 5]) --1.414...</code></pre>
                </div>
                <div id="fn-STDDEV_SAMPLE" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                  <a href="#fn-STDDEV_SAMPLE" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-blue-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                  <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">STDDEV_SAMPLE(arr)</code>
                  <p class="text-sm text-gray-400 mb-3">Sample standard deviation; <code>null</code> for fewer than two values.</p>
                  <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN STDDEV_SAMPLE([1, 2, 3, 4, 5]) --1.581...</code></pre>
                </div>
            </div>

            <div class="bg-gray-800/30 rounded-xl p-5 border border-white/5">
              <h4 class="text-sm font-bold text-gray-300 mb-3">Aggregation Example</h4>
              <pre><code class="language-sql text-xs bg-gray-950/50 p-3 rounded border border-white/5">FOR u IN users
  LET amounts = (FOR o IN orders FILTER o.user == u._key RETURN o.amount)
  RETURN {
    user: u.name,
    total: SUM(amounts),
    avg: ROUND(AVG(amounts), 2),
    count: COUNT(amounts),
    median: MEDIAN(amounts),
    stddev: ROUND(STDDEV(amounts), 2)
  }</code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- Approximate Aggregates -->
      <section id="approximate" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">Approximate Aggregates</h2>
          </div>
          <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div id="fn-APPROX_COUNT_DISTINCT" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                  <a href="#fn-APPROX_COUNT_DISTINCT" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-blue-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                  <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">APPROX_COUNT_DISTINCT(arr, options?)</code>
                  <p class="text-sm text-gray-400 mb-3">HyperLogLog (p = 14) estimate of the number of distinct values — about 0.8% error. Returns the estimate. Pass <code>{sketch: true}</code> to get the sketch object instead (<code>_type: "hll"</code>, <code>estimate</code>, <code>registers</code>), for <code>SKETCH_MERGE</code>; a sketch passed back in returns its estimate.</p>
                  <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN APPROX_COUNT_DISTINCT([1, 1, 2, 3]) --3
LET a = APPROX_COUNT_DISTINCT(xs, {sketch: true})
LET b = APPROX_COUNT_DISTINCT(ys, {sketch: true})
RETURN SKETCH_MERGE(a, b).estimate</code></pre>
                </div>
                <div id="fn-APPROX_PERCENTILE" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                  <a href="#fn-APPROX_PERCENTILE" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-blue-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                  <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">APPROX_PERCENTILE(arr, p)</code>
                  <p class="text-sm text-gray-400 mb-3">Despite the name, exact: the numeric value at index round(p/100 · (n − 1)) of the sorted array. <code>p</code> is 0-100.</p>
                  <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN APPROX_PERCENTILE([1, 2, 3, 4, 5], 50) --3</code></pre>
                </div>
                <div id="fn-APPROX_TOP_K" class="group relative bg-gray-800/40 border border-white/5 rounded-xl p-5 hover:bg-gray-800/60 transition-colors">
                  <a href="#fn-APPROX_TOP_K" class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 text-gray-500 hover:text-blue-400 transition-opacity"><i class="fas fa-link text-xs"></i></a>
                  <code class="block text-sm font-bold text-white bg-blue-500/20 px-2 py-1 rounded border border-blue-500/30 w-fit mb-3">APPROX_TOP_K(arr, k)</code>
                  <p class="text-sm text-gray-400 mb-3">Most frequent values as <code>[{value, count}]</code>, most frequent first. Uses a table of 4k counters (Misra-Gries): counts are exact while the number of distinct values fits, lower bounds after. <code>k</code> is capped at 10,000.</p>
                  <pre><code class="language-sql text-xs bg-gray-950/50 p-2 rounded border border-white/5">RETURN APPROX_TOP_K(["a", "a", "b", "a", "c"], 2)
-- [{value: "a", count: 3}, {value: "b", count: 1}]</code></pre>
                </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Window Functions -->
      <section id="window-functions" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">Window Functions</h2>
          </div>
          <div class="p-8 space-y-4">
            <p class="text-gray-300 leading-relaxed">
              <code>FUNC(args) OVER (PARTITION BY … ORDER BY …)</code> computes a value per row from the rows
              of its partition without collapsing them. See also the
              <a href="/docs/sdbql-syntax#window-functions" class="text-indigo-400 hover:text-indigo-300">syntax guide</a>.
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <tbody>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">ROW_NUMBER()</td><td class="py-2 text-gray-400">1, 2, 3… in window order.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">RANK() / DENSE_RANK()</td><td class="py-2 text-gray-400">Rank with gaps / without gaps; rows with equal ORDER BY values are peers.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">PERCENT_RANK()</td><td class="py-2 text-gray-400">(rank − 1) / (rows − 1); 0 for a single row.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">CUME_DIST()</td><td class="py-2 text-gray-400">Rows up to and including the current row's last peer, over rows.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">NTILE(n)</td><td class="py-2 text-gray-400">Bucket number 1…n; bucket sizes differ by at most one, larger buckets first.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">LAG(expr, offset?, default?) / LEAD(...)</td><td class="py-2 text-gray-400">Value <code>offset</code> rows before / after (default 1), or <code>default</code>.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">FIRST_VALUE(expr) / LAST_VALUE(expr)</td><td class="py-2 text-gray-400">First / last value of the whole partition.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">NTH_VALUE(expr, n)</td><td class="py-2 text-gray-400">Value of the n-th row (1-based) of the whole partition, or <code>null</code>.</td></tr>
                    <tr class="border-t border-white/5"><td class="py-2 pr-4 font-mono text-orange-300 whitespace-nowrap">SUM / AVG / COUNT / MIN / MAX (expr)</td><td class="py-2 text-gray-400">With ORDER BY: running value from the partition start to the current row. Without ORDER BY: the whole partition.</td></tr>
                </tbody>
              </table>
            </div>
            <pre><code class="language-sql text-xs bg-gray-950/50 p-3 rounded border border-white/5">FOR s IN scores
  RETURN {
    name: s.name,
    quartile: NTILE(4) OVER (ORDER BY s.score DESC),
    pct: PERCENT_RANK() OVER (ORDER BY s.score),
    second_best: NTH_VALUE(s.score, 2) OVER (ORDER BY s.score DESC)
  }</code></pre>
          </div>
        </div>
      </section>

