<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-8">
    <a href="/docs" class="inline-flex items-center text-indigo-400 hover:text-indigo-300 font-medium transition-colors group">
      <svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      Back to Documentation
    </a>
  </div>

  <div class="grid grid-cols-12 gap-8 lg:gap-12">
    <!-- Sidebar Partial -->

    <!-- Main Content -->
    <main class="col-span-12 lg:col-span-12 space-y-12">
      <!-- Header Section -->
      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-lg blur opacity-25"></div>
        <div class="relative">
          <h1 class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 mb-4 tracking-tight">Time Series</h1>
          <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
            SoliDB provides native support for time-series data with specialized append-only collections, efficient time-based pruning, and powerful downsampling capabilities using SDBQL.
          </p>
        </div>
      </div>

      <!-- Concepts Section -->
      <section id="concepts" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-gradient-to-r from-cyan-900/20 to-blue-800/10">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
               Core Concepts
            </h2>
          </div>
          <div class="p-8 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-gray-800/20 rounded-xl p-6 border border-white/5">
                <h3 class="font-bold text-white mb-2 flex items-center">
                   <div class="w-8 h-8 rounded bg-gray-700 flex items-center justify-center mr-3"><i class="fas fa-lock text-cyan-400"></i></div>
                   Append-Only Storage
                </h3>
                <p class="text-sm text-gray-400">
                  Time series collections are <strong>immutable</strong>. Once data is written, it cannot be updated, only deleted via range pruning. This optimization allows for high write throughput.
                </p>
              </div>

              <div class="bg-gray-800/20 rounded-xl p-6 border border-white/5">
                <h3 class="font-bold text-white mb-2 flex items-center">
                   <div class="w-8 h-8 rounded bg-gray-700 flex items-center justify-center mr-3"><i class="fas fa-trash-alt text-red-400"></i></div>
                   Efficient Pruning
                </h3>
                <p class="text-sm text-gray-400">
                  Documents get a time-ordered key (UUIDv7), so the oldest are stored first. Pruning walks them from the start and stops at the cut-off: its cost follows what it deletes, not the size of the collection.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Collections Section -->
      <section id="collections" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
               Creating Time Series
            </h2>
          </div>
          <div class="p-8 space-y-6">
            <p class="text-gray-300">
              Create a time series collection by setting the <code>type</code> to <code>timeseries</code>.
            </p>

            <div class="bg-gray-950/50 rounded-xl border border-white/5 p-4">
              <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">HTTP API</h4>
              <pre><code class="language-bash text-sm">curl -X POST http://localhost:8080/_api/database/_system/collection \
  -H "Authorization: Bearer $TOKEN" \
  -d '{
    "name": "metrics",
    "type": "timeseries"
  }'</code></pre>
            </div>

            <div class="bg-yellow-500/10 border border-yellow-500/20 rounded-xl p-4 flex items-start">
              <i class="fas fa-exclamation-triangle text-yellow-400 mt-1 mr-3"></i>
               <div>
                <h4 class="text-yellow-400 font-bold text-sm">Constraint</h4>
                <p class="text-sm text-yellow-200/70">
                  You cannot perform <code>UPDATE</code> or <code>UPSERT</code> operations on time series collections. Only <code>INSERT</code> and <code>PRUNE</code> (bulk delete) are supported.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Querying Section -->
      <section id="querying" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
               Querying & Bucketing
            </h2>
          </div>
          <div class="p-8 space-y-6">
            <p class="text-gray-300">
              <code>TIME_BUCKET()</code> groups timestamps into fixed intervals (e.g. 5 minutes, 1 hour). Array helpers <code>DELTA</code>, <code>RATE</code>, <code>FILL</code>, and <code>RESAMPLE</code> work on numeric series or <code>[{t|ts|time, v|value}, …]</code>. Align two collections in time with <a href="/docs/sdbql-syntax" class="text-cyan-400 hover:underline">ASOF JOIN</a>.
            </p>

            <div class="bg-gray-950/50 rounded-xl border border-white/5 p-4">
              <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Example: Average CPU Usage per hour</h4>
              <pre><code class="language-sql text-sm">FOR m IN metrics
  -- Bucket timestamps into 1-hour intervals
  COLLECT time = TIME_BUCKET(m.timestamp, "1h")
  
  -- Calculate average for each bucket
  AGGREGATE avg_cpu = AVG(m.cpu)
  
  -- Sort by time
  SORT time ASC
  
  RETURN { time, avg_cpu }</code></pre>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <h4 class="text-sm font-bold text-white mb-2">Supported Intervals</h4>
                <ul class="space-y-2 text-sm text-gray-400">
                  <li><code class="text-cyan-400">s</code> - Seconds (e.g., "30s")</li>
                  <li><code class="text-cyan-400">m</code> - Minutes (e.g., "5m", "15m")</li>
                  <li><code class="text-cyan-400">h</code> - Hours (e.g., "1h", "6h")</li>
                  <li><code class="text-cyan-400">d</code> - Days (e.g., "1d", "7d")</li>
                </ul>
              </div>
              <div>
                <h4 class="text-sm font-bold text-white mb-2">Timestamp Formats</h4>
                <p class="text-sm text-gray-400">
                  <code>TIME_BUCKET</code> accepts:
                </p>
                <ul class="list-disc list-inside space-y-1 text-sm text-gray-400 mt-2">
                  <li>Unix timestamp (milliseconds)</li>
                  <li>ISO 8601 Date Strings</li>
                  <li>Negative timestamps (pre-1970)</li>
                </ul>
              </div>
            </div>

            <div class="bg-gray-950/50 rounded-xl border border-white/5 p-4">
              <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Series helpers</h4>
              <pre><code class="language-sql text-sm">RETURN DELTA([{t:0,v:1},{t:10,v:4}])
-- [{t:10,v:3}]

RETURN RATE([{t:0,v:0},{t:1000,v:10}], "1s")
-- [{t:1000,v:10}]   -- change per second

RETURN FILL([{t:0,v:1},{t:1,v:null},{t:2,v:3}], "interp")
RETURN RESAMPLE(points, "5m")   -- last value + avg per bucket</code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- Column blocks Section -->
      <section id="blocks" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
               Column Blocks
            </h2>
          </div>
          <div class="p-8 space-y-6">
            <p class="text-gray-300">
              An aggregation over documents reads documents: one per point. A time series collection can keep, beside its documents, the fields its aggregations read as arrays. Declare the time field (integer milliseconds) and the other fields, strings (a series' name, a tag) or numbers:
            </p>

            <div class="bg-gray-950/50 rounded-xl border border-white/5 p-6">
               <div class="flex items-center gap-3 mb-4">
                 <span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 text-xs font-bold rounded">PUT</span>
                 <code class="text-gray-300">/_api/database/:db/collection/:name/blocks</code>
               </div>
              <div class="bg-black/30 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                { "time": "ts", "fields": ["host", "cpu"] }
              </div>
            </div>

            <p class="text-gray-300">
              From then on the documents are sealed into blocks as they arrive, by a background thread that no write waits for (1,024 at a time, the newest 512 left for later; small blocks are merged up to 65,536 points). The documents stay what is stored and what every other query reads; a block is derived from them and is thrown away when a document of its range is written or deleted.
            </p>
            <p class="text-gray-300">
              A query is answered from the blocks when it stays within them: <code>FOR p IN c</code>, FILTERs that compare the time field with numbers (<code>&gt;=</code>, <code>&gt;</code>, <code>&lt;</code>, <code>&lt;=</code>) and other declared fields with strings (<code>==</code>), joined by <code>AND</code>, then a <code>COLLECT</code> whose keys are declared fields or <code>TIME_BUCKET(time, "5m")</code> (a fixed interval, no options) and whose aggregates take a declared field or nothing. The answers are those of the documents, to the last digit: an integer sum stays an integer, a float sum is exact. Anything else runs as before, and EXPLAIN says which: <code>COLLECT folded from the column blocks</code>.
            </p>
            <p class="text-sm text-gray-400 mb-4">
              A query that returns rows uses the blocks to read less: <code>FOR p IN c FILTER p.ts &gt;= @from AND p.ts &lt; @to RETURN p</code>, or the same with <code>p.series == @s</code>, reads only the documents of the blocks that can hold such a point, where it used to read the collection. A block knows the times and the series of its points, not their keys, so the documents of a block that may hold a row are all read, and the FILTERs run on them as before: same rows, same order. A span of time narrows the read to a few blocks. A series alone does not, when every block holds points of it: for that question keep an index on the series field.
            </p>

            <div class="bg-gray-950/50 rounded-xl border border-white/5 p-4">
              <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Example: answered from the blocks</h4>
              <pre><code class="language-sql text-sm">FOR p IN metrics
  FILTER p.host == "web-3" AND p.ts >= @from AND p.ts &lt; @to
  COLLECT bucket = TIME_BUCKET(p.ts, "5m")
  AGGREGATE cpu = AVG(p.cpu), peak = MAX(p.cpu)
  RETURN { bucket, cpu, peak }</code></pre>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left text-gray-400">
                <thead class="text-xs text-gray-300 uppercase bg-white/5">
                  <tr><th class="px-4 py-2">Method &amp; path</th><th class="px-4 py-2">Effect</th></tr>
                </thead>
                <tbody>
                  <tr class="border-b border-white/5"><td class="px-4 py-2"><code>GET …/collection/:name/blocks</code></td><td class="px-4 py-2">The definition, the number of blocks, and how many documents they cover.</td></tr>
                  <tr class="border-b border-white/5"><td class="px-4 py-2"><code>PUT …/collection/:name/blocks</code></td><td class="px-4 py-2">Declare or replace the definition. Blocks of an earlier one are deleted.</td></tr>
                  <tr class="border-b border-white/5"><td class="px-4 py-2"><code>POST …/collection/:name/blocks/seal</code></td><td class="px-4 py-2">Seal everything not yet in a block, the newest points included: after a bulk load, a restart, or a large delete.</td></tr>
                  <tr><td class="px-4 py-2"><code>DELETE …/collection/:name/blocks</code></td><td class="px-4 py-2">Stop keeping blocks. The documents are untouched.</td></tr>
                </tbody>
              </table>
            </div>

            <div class="bg-blue-500/10 border border-blue-500/20 rounded-xl p-4 flex items-start">
              <i class="fas fa-info-circle text-blue-400 mt-1 mr-3"></i>
               <div>
                <h4 class="text-blue-400 font-bold text-sm">What to know</h4>
                <p class="text-sm text-blue-200/70">
                  A field must hold one kind of value throughout a block: strings, or numbers (integers and floats may be mixed). A range of points where a declared field is missing or null, or the time is not an integer, gets a block without columns and is read as documents (<code>opaque_blocks</code> in the status). Blocks cost about 25 bytes per point in memory, up to <code>SOLIDB_COLUMN_BLOCKS_MB</code> (1024 by default) for the whole server, and as much on disk. A delete or a late point throws away the block it falls in; a background thread seals its range again, and meanwhile the query runs as it did without blocks. Blocks and their definition are local to a node: declare them on each node of a cluster. Only a <code>timeseries</code> collection takes them, because its documents are never updated.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Pruning Section -->
      <section id="pruning" class="scroll-mt-24">
        <div class="bg-gray-900/40 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-8 border-b border-white/5 bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center">
              <svg class="w-6 h-6 mr-3 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
               Data Pruning
            </h2>
          </div>
          <div class="p-8 space-y-6">
            <p class="text-gray-300">
              Delete old data using the prune API. It reads only the documents older than the cut-off (they come first in key order) and deletes them in batches of 10,000, each with its index entries; a <code>REMOVE</code> query would filter the whole collection. A document whose <code>_key</code> you chose yourself, rather than the generated UUIDv7, is never pruned.
            </p>

            <div class="bg-gray-950/50 rounded-xl border border-white/5 p-6">
               <div class="flex items-center gap-3 mb-4">
                 <span class="px-2 py-1 bg-red-500/20 text-red-400 text-xs font-bold rounded">POST</span>
                 <code class="text-gray-300">/_api/database/:db/collection/:name/prune</code>
               </div>

              <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Request Body</h4>
              <div class="bg-black/30 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                {
                  "older_than": "2023-01-01T00:00:00Z"
                }
              </div>

               <div class="mt-4 mb-4">
                 <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Response</h4>
                   <div class="bg-black/30 p-3 rounded border border-white/5 font-mono text-xs text-gray-300">
                   {
                     "deleted": 15420
                   }
                  </div>
               </div>
            </div>
            
             <div class="bg-blue-500/10 border border-blue-500/20 rounded-xl p-4 flex items-start">
              <i class="fas fa-info-circle text-blue-400 mt-1 mr-3"></i>
               <div>
                <h4 class="text-blue-400 font-bold text-sm">Note</h4>
                <p class="text-sm text-blue-200/70">
                  <code>deleted</code> is the exact number of documents removed. Through 2.10.2 a prune read every key of the collection, even with nothing to delete.
                </p>
              </div>
            </div>

          </div>
        </div>
      </section>

    </main>
  </div>
</div>
