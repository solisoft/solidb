<section class="blog-head">
  <div class="wrap">
    <span class="eyebrow">SoliDB blog</span>
    <h1>Release notes and deep dives</h1>
    <p>What changed in each release, why, and how to use it — with queries you can paste into a running server.</p>
  </div>
</section>

<section class="wrap blog-list">
  <% for post, index in posts %>
  <article class="post-card">
    <a class="post-card-cover" href="/blog/<%= post["slug"] %>" tabindex="-1" aria-hidden="true"><%- partial("blog/cover", {"post": post, "css_class": "post-thumb", "loading": index < 3 ? "eager" : "lazy"}) %></a>
    <div class="post-card-text">
    <p class="post-meta"><time datetime="<%= post["date"] %>"><%= post["display_date"] %></time> · <%= post["read_minutes"] %> min read</p>
    <h2><a href="/blog/<%= post["slug"] %>"><%= post["title"] %></a></h2>
    <p class="post-summary"><%= post["summary"] %></p>
    <p class="post-tags">
      <% for tag in post["tags"] %><span class="post-tag"><%= tag %></span><% end %>
    </p>
    </div>
  </article>
  <% end %>
</section>
