<text x="237" y="73" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" fill="#ff6b6b">OPTIONS rewrite</text>
<rect x="340" y="40" width="120" height="40" fill="#141d1b" stroke="#29322f"/>
<text x="400" y="65" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="12" fill="#ece6d6">write orders</text>
